## NPM configuration for Wapsell Unified Monorepo
## Optimizes install, build, and CI/CD performance

# Registry
registry=https://registry.npmjs.org/

# Install optimization
prefer-offline=true
fetch-timeout=60000
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Handle peer dependency conflicts (required for workspaces)
legacy-peer-deps=true

# Performance and caching
cache-min=3600000
cache-dir=.npm-cache

# Security
audit-level=moderate

# Workspace support
workspaces=true

# Git integration
save-exact=false

# Logging
loglevel=warn
