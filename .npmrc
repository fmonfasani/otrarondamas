## NPM optimization for CI/CD
## Reduces install time and improves reliability

# Registry settings
registry=https://registry.npmjs.org/

# Install optimization
prefer-offline=true
fetch-timeout=30000
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Performance and caching
cache-dir=.npm-cache
legacy-peer-deps=false

# Security: disable audit in CI for speed, audit run separately
audit=false

# Workspace support
workspaces=true

# Prefer exact versions
save-exact=false
