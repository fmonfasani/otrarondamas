generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AperturaCaja {
  id             String           @id @default(uuid())
  cajaId         String
  usuarioId      String
  montoInicial   Decimal
  fechaApertura  DateTime         @default(now())
  fechaCierre    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime @updatedAt
  Caja           Caja             @relation(fields: [cajaId], references: [id])
  Usuario        Usuario          @relation(fields: [usuarioId], references: [id])
  ArqueoCaja     ArqueoCaja[]
  CierreCaja     CierreCaja?
  MovimientoCaja MovimientoCaja[]
}

model AplicacionPago {
  id            String   @id @default(uuid())
  pagoId        String
  deudaId       String
  montoAplicado Decimal
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  Deuda         Deuda    @relation(fields: [deudaId], references: [id])
  Pago          Pago     @relation(fields: [pagoId], references: [id])

  @@unique([pagoId, deudaId])
}

model ArqueoCaja {
  id                                            String        @id @default(uuid())
  cajaId                                        String
  aperturaCajaId                                String
  usuarioId                                     String
  fondoFijoContado                              Decimal
  efectivoVentasContado                         Decimal
  efectivoDeudasContado                         Decimal
  gastosRetirosRegistrados                      Decimal
  efectivoEsperado                              Decimal
  efectivoContado                               Decimal
  diferencia                                    Decimal
  autorizacionId                                String?
  fechaArqueo                                   DateTime      @default(now())
  createdAt                                     DateTime      @default(now())
  updatedAt                                     DateTime @updatedAt
  usuarioEntranteId                             String
  AperturaCaja                                  AperturaCaja  @relation(fields: [aperturaCajaId], references: [id])
  Autorizacion                                  Autorizacion? @relation(fields: [autorizacionId], references: [id])
  Caja                                          Caja          @relation(fields: [cajaId], references: [id])
  Usuario_ArqueoCaja_usuarioEntranteIdToUsuario Usuario       @relation("ArqueoCaja_usuarioEntranteIdToUsuario", fields: [usuarioEntranteId], references: [id])
  Usuario_ArqueoCaja_usuarioIdToUsuario         Usuario       @relation("ArqueoCaja_usuarioIdToUsuario", fields: [usuarioId], references: [id])
}

model Attachment {
  id          String    @id @default(uuid())
  messageId   String
  storageKey  String
  filename    String
  mimeType    String
  sizeBytes   BigInt
  durationSec Int?
  metadata    Json?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  Message     Message   @relation(fields: [messageId], references: [id])

  @@index([messageId, deletedAt])
  @@index([storageKey])
}

model AuditLog {
  id                 String        @id @default(uuid())
  empresaId          String
  usuarioId          String?
  fechaHora          DateTime      @default(now())
  accion             String
  entidadAfectada    String
  entidadId          String?
  valoresAnteriores  Json?
  valoresPosteriores Json?
  motivo             String?
  autorizacionId     String?
  ventaId            String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime @updatedAt
  Autorizacion       Autorizacion? @relation(fields: [autorizacionId], references: [id])
  Empresa            Empresa       @relation(fields: [empresaId], references: [id])
  Usuario            Usuario?      @relation(fields: [usuarioId], references: [id])
  Venta              Venta?        @relation(fields: [ventaId], references: [id])
}

model Autorizacion {
  id                String       @id @default(uuid())
  empresaId         String
  autorizadorId     String
  operacion         String
  entidadAfectada   String?
  entidadId         String?
  motivo            String?
  fechaAutorizacion DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime @updatedAt
  ArqueoCaja        ArqueoCaja[]
  AuditLog          AuditLog[]
  Usuario           Usuario      @relation(fields: [autorizadorId], references: [id])
  Empresa           Empresa      @relation(fields: [empresaId], references: [id])
}

model Caja {
  id             String           @id @default(uuid())
  empresaId      String           @unique
  nombre         String           @default("Caja Principal")
  fondoFijo      Decimal
  estado         EstadoCaja       @default(CERRADA)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime @updatedAt
  AperturaCaja   AperturaCaja[]
  ArqueoCaja     ArqueoCaja[]
  Empresa        Empresa          @relation(fields: [empresaId], references: [id])
  MovimientoCaja MovimientoCaja[]
}

model CapabilityDefinition {
  id              String            @id @default(uuid())
  code            String            @unique
  description     String?
  category        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime @updatedAt
  CapabilityGrant CapabilityGrant[]
  RoleCapability  RoleCapability[]
}

model CapabilityGrant {
  id                   String               @id @default(uuid())
  roleGrantId          String
  capabilityDefId      String
  grantType            String               @default("GRANT")
  reason               String?
  grantedBy            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime @updatedAt
  CapabilityDefinition CapabilityDefinition @relation(fields: [capabilityDefId], references: [id])
  RoleGrant            RoleGrant            @relation(fields: [roleGrantId], references: [id], onDelete: Cascade)

  @@unique([roleGrantId, capabilityDefId])
  @@index([roleGrantId])
}

model Cart {
  id         String     @id @default(uuid())
  customerId String
  businessId String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime @updatedAt
  Empresa    Empresa    @relation(fields: [businessId], references: [id])
  Cliente    Cliente    @relation(fields: [customerId], references: [id])
  CartItem   CartItem[]

  @@unique([customerId, businessId])
  @@index([businessId, customerId])
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String
  productoId String
  cantidad   Decimal
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  Producto   Producto @relation(fields: [productoId], references: [id])

  @@unique([cartId, productoId])
  @@index([cartId])
}

model CierreCaja {
  id             String       @id @default(uuid())
  aperturaCajaId String       @unique
  usuarioId      String
  fechaCierre    DateTime     @default(now())
  montoFinal     Decimal
  createdAt      DateTime     @default(now())
  updatedAt      DateTime @updatedAt
  AperturaCaja   AperturaCaja @relation(fields: [aperturaCajaId], references: [id])
  Usuario        Usuario      @relation(fields: [usuarioId], references: [id])
}

model Cliente {
  id                      String                    @id @default(uuid())
  empresaId               String
  nombre                  String
  email                   String?
  telefono                String?
  direccion               String?
  limiteCredito           Decimal?
  activo                  Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime @updatedAt
  condicionIva            String?
  cuit                    String?
  esMayorista             Boolean                   @default(false)
  estadoLegajo            EstadoLegajo?
  googleId                String?                   @unique
  passwordHash            String?
  razonSocial             String?
  Cart                    Cart[]
  Empresa                 Empresa                   @relation(fields: [empresaId], references: [id])
  ConversationParticipant ConversationParticipant[]
  CuentaCorriente         CuentaCorriente[]
  Deuda                   Deuda[]
  DevolucionCliente       DevolucionCliente[]
  Legajo                  Legajo?
  Message                 Message[]
  MessageReadReceipt      MessageReadReceipt[]
  MessagingReadPreference MessagingReadPreference[]
  Pedido                  Pedido[]
  Venta                   Venta[]
  PhoneNumber             PhoneNumber[]
  SMSAlert                SMSAlert[]
  EmailPreference         EmailPreference?      @relation("EmailPreference_cliente")

  @@unique([empresaId, email])
  @@unique([id, empresaId])
}

model Compra {
  id                     String                @id @default(uuid())
  empresaId              String
  proveedorId            String
  usuarioId              String
  estado                 EstadoCompra          @default(BORRADOR)
  total                  Decimal
  fechaOrden             DateTime              @default(now())
  fechaRecepcionEsperada DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime @updatedAt
  fechaVencimientoPago   DateTime?
  numeroFactura          String?
  saldo                  Decimal               @default(0)
  totalPagado            Decimal               @default(0)
  Empresa                Empresa               @relation(fields: [empresaId], references: [id])
  Proveedor              Proveedor             @relation(fields: [proveedorId], references: [id])
  Usuario                Usuario               @relation(fields: [usuarioId], references: [id])
  CompraItem             CompraItem[]
  DevolucionProveedor    DevolucionProveedor[]
  PagoProveedor          PagoProveedor[]
  RecepcionCompra        RecepcionCompra[]
}

model CompraItem {
  id               String   @id @default(uuid())
  compraId         String
  productoId       String
  cantidadPedida   Decimal
  cantidadRecibida Decimal  @default(0)
  costoUnitario    Decimal
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  Compra           Compra   @relation(fields: [compraId], references: [id])
  Producto         Producto @relation(fields: [productoId], references: [id])
}

model Conversation {
  id                      String                    @id @default(uuid())
  businessId              String
  type                    MessagingConversationType
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime @updatedAt
  deletedAt               DateTime?
  Empresa                 Empresa                   @relation(fields: [businessId], references: [id])
  ConversationAssociation ConversationAssociation[]
  ConversationParticipant ConversationParticipant[]
  Message                 Message[]

  @@unique([id, businessId])
  @@index([businessId, deletedAt])
  @@index([businessId, updatedAt])
}

model ConversationAssociation {
  id             String                   @id @default(uuid())
  conversationId String
  businessId     String
  entityType     MessagingAssociationType
  entityId       String
  active         Boolean                  @default(true)
  changedBy      String?
  reason         String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime @updatedAt
  Conversation   Conversation             @relation(fields: [conversationId, businessId], references: [id, businessId])

  @@index([businessId, conversationId, active])
  @@index([businessId, entityType, entityId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ConversationParticipant {
  id                   String       @id @default(uuid())
  conversationId       String
  businessId           String
  userId               String?
  membershipBusinessId String?
  customerId           String?
  customerBusinessId   String?
  joinedAt             DateTime     @default(now())
  leftAt               DateTime?
  removedAt            DateTime?
  isAdmin              Boolean      @default(false)
  Conversation         Conversation @relation(fields: [conversationId, businessId], references: [id, businessId])
  Cliente              Cliente?     @relation(fields: [customerId, customerBusinessId], references: [id, empresaId])
  Membership           Membership?  @relation(fields: [userId, membershipBusinessId], references: [userId, businessId])

  @@index([businessId, customerId])
  @@index([businessId, userId])
  @@index([conversationId, joinedAt])
  @@index([conversationId, leftAt])
}

model CuentaCorriente {
  id        String   @id @default(uuid())
  empresaId String
  clienteId String
  saldo     Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Cliente   Cliente  @relation(fields: [clienteId], references: [id])
  Empresa   Empresa  @relation(fields: [empresaId], references: [id])
  Deuda     Deuda[]
  Pago      Pago[]

  @@unique([empresaId, clienteId])
}

model Deuda {
  id                String           @id @default(uuid())
  empresaId         String
  clienteId         String
  ventaId           String?
  montoTotal        Decimal
  montoPendiente    Decimal
  fechaVencimiento  DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime @updatedAt
  cuentaCorrienteId String?
  AplicacionPago    AplicacionPago[]
  Cliente           Cliente          @relation(fields: [clienteId], references: [id])
  CuentaCorriente   CuentaCorriente? @relation(fields: [cuentaCorrienteId], references: [id])
  Empresa           Empresa          @relation(fields: [empresaId], references: [id])
  Venta             Venta?           @relation(fields: [ventaId], references: [id])
}

model DevolucionCliente {
  id                    String                   @id @default(uuid())
  empresaId             String
  negocioId             String?
  clienteId             String
  ventaId               String
  creadoPorId           String
  numeroDevolucion      Int?
  estado                EstadoDevolucion        @default(SOLICITADA)
  fechaSolicitud        DateTime                @default(now())
  fechaAutorizacion     DateTime?
  fechaRecibida         DateTime?
  fechaProcesada        DateTime?
  ventaFecha            DateTime
  diasDesdeVenta        Int?
  montoTotal            Decimal  @db.Decimal(14, 2)
  montoComisiones       Decimal  @db.Decimal(14, 2) @default(0)
  montoReembolsable     Decimal  @db.Decimal(14, 2)
  motivo                String
  observaciones         String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  createdBy             String?

  Cliente               Cliente                 @relation(fields: [clienteId], references: [id])
  Empresa               Empresa                 @relation(fields: [empresaId], references: [id])
  Venta                 Venta                   @relation(fields: [ventaId], references: [id])
  CreadoPor             Usuario?                @relation("DevolucionCliente_creadoPorIdToUsuario", fields: [createdBy], references: [id])
  DevolucionClienteItem DevolucionClienteItem[]
  Reembolso             Reembolso?

  @@unique([empresaId, numeroDevolucion])
  @@index([empresaId, estado])
  @@index([empresaId, clienteId])
  @@index([empresaId, ventaId])
  @@index([empresaId, createdAt])
  @@index([estado, fechaSolicitud])
}

model DevolucionClienteItem {
  id                      String   @id @default(uuid())
  devolucionClienteId     String
  ventaItemId             String
  productoId              String
  cantidad                Decimal  @db.Decimal(14, 2)
  precioUnitarioOriginal  Decimal  @db.Decimal(14, 2)
  precioDevuelto          Decimal  @db.Decimal(14, 2)
  descuentoItem           Decimal  @db.Decimal(14, 2) @default(0)
  montoLineaDevuelto      Decimal  @db.Decimal(14, 2)
  motivo                  String?
  observaciones           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  DevolucionCliente       DevolucionCliente @relation(fields: [devolucionClienteId], references: [id], onDelete: Cascade)
  VentaItem               VentaItem         @relation(fields: [ventaItemId], references: [id])
  Producto                Producto          @relation(fields: [productoId], references: [id])

  @@unique([devolucionClienteId, ventaItemId])
  @@index([devolucionClienteId])
  @@index([ventaItemId])
}

model Reembolso {
  id                      String   @id @default(uuid())
  devolucionClienteId     String   @unique
  empresaId               String
  referenceId             String?
  estado                  EstadoReembolso     @default(PENDIENTE)
  montoReembolsable       Decimal  @db.Decimal(14, 2)
  montoActual             Decimal  @db.Decimal(14, 2)
  metodoReembolso         String?
  intentos                Int      @default(0)
  ultimoIntento           DateTime?
  proximoIntento          DateTime?
  resultado               String?
  motivoFalla             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  procesadoEn             DateTime?

  DevolucionCliente       DevolucionCliente @relation(fields: [devolucionClienteId], references: [id], onDelete: Cascade)
  Empresa                 Empresa           @relation(fields: [empresaId], references: [id])

  @@index([empresaId, estado])
  @@index([empresaId, createdAt])
  @@index([estado, proximoIntento])
}

model DevolucionProveedor {
  id                      String                    @id @default(uuid())
  empresaId               String
  compraId                String
  proveedorId             String
  usuarioId               String
  motivo                  String
  fecha                   DateTime                  @default(now())
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime @updatedAt
  Compra                  Compra                    @relation(fields: [compraId], references: [id])
  Empresa                 Empresa                   @relation(fields: [empresaId], references: [id])
  Proveedor               Proveedor                 @relation(fields: [proveedorId], references: [id])
  Usuario                 Usuario                   @relation(fields: [usuarioId], references: [id])
  DevolucionProveedorItem DevolucionProveedorItem[]
}

model DevolucionProveedorItem {
  id                  String              @id @default(uuid())
  devolucionId        String
  productoId          String
  loteId              String?
  cantidad            Decimal
  costoUnitario       Decimal
  DevolucionProveedor DevolucionProveedor @relation(fields: [devolucionId], references: [id])
  Lote                Lote?               @relation(fields: [loteId], references: [id])
  Producto            Producto            @relation(fields: [productoId], references: [id])
}

model DocumentoLegajo {
  id            String              @id @default(uuid())
  legajoId      String
  tipo          TipoDocumentoLegajo
  rutaArchivo   String
  nombreArchivo String
  vencimiento   DateTime
  createdAt     DateTime            @default(now())
  updatedAt     DateTime @updatedAt
  Legajo        Legajo              @relation(fields: [legajoId], references: [id])
}

model Empresa {
  id                      String                    @id @default(uuid())
  nombre                  String                    @unique
  configuracion           Json
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime @updatedAt
  slug                    String                    @unique
  AuditLog                AuditLog[]
  Autorizacion            Autorizacion[]
  Caja                    Caja?
  Cart                    Cart[]
  Cliente                 Cliente[]
  Compra                  Compra[]
  Conversation            Conversation[]
  CuentaCorriente         CuentaCorriente[]
  Deuda                   Deuda[]
  DevolucionCliente       DevolucionCliente[]
  DevolucionProveedor     DevolucionProveedor[]
  Entrega                 Entrega[]
  Familia                 Familia[]
  Invitacion              Invitacion[]
  Lote                    Lote[]
  Membership              Membership[]
  MessageReadReceipt      MessageReadReceipt[]
  MessagingReadPreference MessagingReadPreference[]
  MovimientoStock         MovimientoStock[]
  Notificacion            Notificacion[]
  Pago                    Pago[]
  PagoProveedor           PagoProveedor[]
  Pedido                  Pedido[]
  Presentacion            Presentacion[]
  Producto                Producto[]
  ProductoProveedor       ProductoProveedor[]
  Proveedor               Proveedor[]
  Reembolso               Reembolso[]
  RecepcionCompra         RecepcionCompra[]
  ReglaFidelizacion       ReglaFidelizacion[]
  Subfamilia              Subfamilia[]
  Subtipo                 Subtipo[]
  Tipo                    Tipo[]
  Usuario                 Usuario[]
  Venta                   Venta[]
  PhoneNumber             PhoneNumber[]
  SMSAlert                SMSAlert[]
  NotificationPreference  NotificationPreference[]
  NotificationDigest      NotificationDigest[]
  EmailTemplate           EmailTemplate[]
  EmailLog                EmailLog[]
  EmailPreference         EmailPreference[]
  EmailCampaign           EmailCampaign[]
  AnalyticsEvent          AnalyticsEvent[]
  AnalyticsAggregation    AnalyticsAggregation[]
  AnalyticsDashboard      AnalyticsDashboard[]
  Payment                 Payment[]
  PaymentIntent           PaymentIntent[]
  PaymentWebhook          PaymentWebhook[]
  Refund                  Refund[]
}

model AnalyticsEvent {
  id                String   @id @default(uuid())
  empresaId         String
  userId            String?
  eventType         String   // 'PAGE_VIEW', 'CONVERSION', 'ERROR', 'PERFORMANCE', 'CUSTOM'
  eventName         String   // e.g., 'checkout_started', 'product_viewed'
  category          String?  // e.g., 'sales', 'inventory', 'users'
  timestamp         DateTime @default(now())
  metadata          Json?    // {productId, quantity, value, customerId, orderId, errorMessage, duration, ...}
  sessionId         String?  // For session-based tracking
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  Empresa           Empresa  @relation(fields: [empresaId], references: [id])

  @@index([empresaId, eventType, timestamp])
  @@index([empresaId, userId, timestamp])
  @@index([sessionId])
}

model AnalyticsAggregation {
  id                String   @id @default(uuid())
  empresaId         String
  period            String   // 'DAILY', 'WEEKLY', 'MONTHLY'
  periodStart       DateTime
  periodEnd         DateTime
  eventType         String   // 'PAGE_VIEW', 'CONVERSION', 'ERROR', 'PERFORMANCE'
  eventName         String?  // NULL for aggregated by type
  count             Int
  uniqueUsers       Int
  avgValue          Decimal? // For conversions/revenue
  metadata          Json?    // {topProducts, topPages, errorRate, ...}
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  Empresa           Empresa  @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, period, periodStart, eventType, eventName])
  @@index([empresaId, period, periodStart])
}

model AnalyticsDashboard {
  id                String   @id @default(uuid())
  empresaId         String
  name              String
  description       String?
  dashboardConfig   Json     // {widgets: [{type, metric, period, filters}]}
  isPublic          Boolean  @default(false)
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  Empresa           Empresa  @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
}

model Entrega {
  id                                    String    @id @default(uuid())
  empresaId                             String
  pedidoId                              String    @unique
  preparadorId                          String?
  repartidorId                          String?
  resultado                             String?
  medioCobro                            String?
  fechaEntrega                          DateTime?
  createdAt                             DateTime  @default(now())
  updatedAt                             DateTime @updatedAt
  Empresa                               Empresa   @relation(fields: [empresaId], references: [id])
  Pedido                                Pedido    @relation(fields: [pedidoId], references: [id])
  Usuario_Entrega_preparadorIdToUsuario Usuario?  @relation("Entrega_preparadorIdToUsuario", fields: [preparadorId], references: [id])
  Usuario_Entrega_repartidorIdToUsuario Usuario?  @relation("Entrega_repartidorIdToUsuario", fields: [repartidorId], references: [id])
}

model Familia {
  id                String              @id @default(uuid())
  empresaId         String
  nombre            String
  prefijo           String              @db.Char(3)
  activo            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime @updatedAt
  Empresa           Empresa             @relation(fields: [empresaId], references: [id])
  Producto          Producto[]
  ReglaFidelizacion ReglaFidelizacion[]
  Subfamilia        Subfamilia[]

  @@unique([empresaId, nombre])
  @@unique([empresaId, prefijo])
}

model Invitacion {
  id            String     @id @default(uuid())
  empresaId     String
  email         String
  rol           RolUsuario
  token         String     @unique
  invitadoPorId String
  expiraEn      DateTime
  usadaEn       DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime @updatedAt
  Empresa       Empresa    @relation(fields: [empresaId], references: [id])
  Usuario       Usuario    @relation(fields: [invitadoPorId], references: [id])
}

model Legajo {
  id               String            @id @default(uuid())
  usuarioId        String?           @unique
  clienteId        String?           @unique
  cuit             String?
  razonSocial      String?
  condicionIva     String?
  tipoFactura      String?
  dni              String?
  telefono         String?
  direccion        String?
  vehiculoDatos    String?
  licenciaConducir String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime @updatedAt
  DocumentoLegajo  DocumentoLegajo[]
  Cliente          Cliente?          @relation(fields: [clienteId], references: [id])
  Usuario          Usuario?          @relation(fields: [usuarioId], references: [id])
}

model Lote {
  id                      String                    @id @default(uuid())
  empresaId               String
  productoId              String
  numeroLote              String
  vencimiento             DateTime
  cantidad                Decimal
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime @updatedAt
  DevolucionProveedorItem DevolucionProveedorItem[]
  Empresa                 Empresa                   @relation(fields: [empresaId], references: [id])
  Producto                Producto                  @relation(fields: [productoId], references: [id])
  MovimientoStock         MovimientoStock[]

  @@unique([productoId, numeroLote, empresaId])
