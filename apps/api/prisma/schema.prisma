  Cart                    Cart[]
  Cliente                 Cliente[]
  Compra                  Compra[]
  Conversation            Conversation[]
  CustomerLabel           CustomerLabel[]
  CuentaCorriente         CuentaCorriente[]
  Deuda                   Deuda[]
  DevolucionCliente       DevolucionCliente[]
  DevolucionProveedor     DevolucionProveedor[]
  Entrega                 Entrega[]
  Familia                 Familia[]
  Invitacion              Invitacion[]
  Lote                    Lote[]
  Membership              Membership[]
