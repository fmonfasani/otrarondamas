generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AperturaCaja {
  id             String           @id
  cajaId         String
  usuarioId      String
  montoInicial   Decimal
  fechaApertura  DateTime         @default(now())
  fechaCierre    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Caja           Caja             @relation(fields: [cajaId], references: [id])
  Usuario        Usuario          @relation(fields: [usuarioId], references: [id])
  ArqueoCaja     ArqueoCaja[]
  CierreCaja     CierreCaja?
  MovimientoCaja MovimientoCaja[]
}

model AplicacionPago {
  id            String   @id
  pagoId        String
  deudaId       String
  montoAplicado Decimal
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Deuda         Deuda    @relation(fields: [deudaId], references: [id])
  Pago          Pago     @relation(fields: [pagoId], references: [id])

  @@unique([pagoId, deudaId])
}

model ArqueoCaja {
  id                                            String        @id
  cajaId                                        String
  aperturaCajaId                                String
  usuarioId                                     String
  fondoFijoContado                              Decimal
  efectivoVentasContado                         Decimal
  efectivoDeudasContado                         Decimal
  gastosRetirosRegistrados                      Decimal
  efectivoEsperado                              Decimal
  efectivoContado                               Decimal
  diferencia                                    Decimal
  autorizacionId                                String?
  fechaArqueo                                   DateTime      @default(now())
  createdAt                                     DateTime      @default(now())
  updatedAt                                     DateTime
  usuarioEntranteId                             String
  AperturaCaja                                  AperturaCaja  @relation(fields: [aperturaCajaId], references: [id])
  Autorizacion                                  Autorizacion? @relation(fields: [autorizacionId], references: [id])
  Caja                                          Caja          @relation(fields: [cajaId], references: [id])
  Usuario_ArqueoCaja_usuarioEntranteIdToUsuario Usuario       @relation("ArqueoCaja_usuarioEntranteIdToUsuario", fields: [usuarioEntranteId], references: [id])
  Usuario_ArqueoCaja_usuarioIdToUsuario         Usuario       @relation("ArqueoCaja_usuarioIdToUsuario", fields: [usuarioId], references: [id])
}

model Attachment {
  id          String    @id
  messageId   String
  storageKey  String
  filename    String
  mimeType    String
  sizeBytes   BigInt
  durationSec Int?
  metadata    Json?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  Message     Message   @relation(fields: [messageId], references: [id])

  @@index([messageId, deletedAt])
  @@index([storageKey])
}

model AuditLog {
  id                 String        @id
  empresaId          String
  usuarioId          String?
  fechaHora          DateTime      @default(now())
  accion             String
  entidadAfectada    String
  entidadId          String?
  valoresAnteriores  Json?
  valoresPosteriores Json?
  motivo             String?
  autorizacionId     String?
  ventaId            String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime
  Autorizacion       Autorizacion? @relation(fields: [autorizacionId], references: [id])
  Empresa            Empresa       @relation(fields: [empresaId], references: [id])
  Usuario            Usuario?      @relation(fields: [usuarioId], references: [id])
  Venta              Venta?        @relation(fields: [ventaId], references: [id])
}

model Autorizacion {
  id                String       @id
  empresaId         String
  autorizadorId     String
  operacion         String
  entidadAfectada   String?
  entidadId         String?
  motivo            String?
  fechaAutorizacion DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime
  ArqueoCaja        ArqueoCaja[]
  AuditLog          AuditLog[]
  Usuario           Usuario      @relation(fields: [autorizadorId], references: [id])
  Empresa           Empresa      @relation(fields: [empresaId], references: [id])
}

model Caja {
  id             String           @id
  empresaId      String           @unique
  nombre         String           @default("Caja Principal")
  fondoFijo      Decimal
  estado         EstadoCaja       @default(CERRADA)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  AperturaCaja   AperturaCaja[]
  ArqueoCaja     ArqueoCaja[]
  Empresa        Empresa          @relation(fields: [empresaId], references: [id])
  MovimientoCaja MovimientoCaja[]
}

model CapabilityDefinition {
  id              String            @id
  code            String            @unique
  description     String?
  category        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  CapabilityGrant CapabilityGrant[]
  RoleCapability  RoleCapability[]
}

model CapabilityGrant {
  id                   String               @id
  roleGrantId          String
  capabilityDefId      String
  grantType            String               @default("GRANT")
  reason               String?
  grantedBy            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime
  CapabilityDefinition CapabilityDefinition @relation(fields: [capabilityDefId], references: [id])
  RoleGrant            RoleGrant            @relation(fields: [roleGrantId], references: [id], onDelete: Cascade)

  @@unique([roleGrantId, capabilityDefId])
  @@index([roleGrantId])
}

model Cart {
  id         String     @id
  customerId String
  businessId String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime
  Empresa    Empresa    @relation(fields: [businessId], references: [id])
  Cliente    Cliente    @relation(fields: [customerId], references: [id])
  CartItem   CartItem[]

  @@unique([customerId, businessId])
  @@index([businessId, customerId])
}

model CartItem {
  id         String   @id
  cartId     String
  productoId String
  cantidad   Decimal
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  Producto   Producto @relation(fields: [productoId], references: [id])

  @@unique([cartId, productoId])
  @@index([cartId])
}

model CierreCaja {
  id             String       @id
  aperturaCajaId String       @unique
  usuarioId      String
  fechaCierre    DateTime     @default(now())
  montoFinal     Decimal
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  AperturaCaja   AperturaCaja @relation(fields: [aperturaCajaId], references: [id])
  Usuario        Usuario      @relation(fields: [usuarioId], references: [id])
}

model Cliente {
  id                      String                    @id
  empresaId               String
  nombre                  String
  email                   String?
  telefono                String?
  direccion               String?
  limiteCredito           Decimal?
  activo                  Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  condicionIva            String?
  cuit                    String?
  esMayorista             Boolean                   @default(false)
  estadoLegajo            EstadoLegajo?
  googleId                String?                   @unique
  passwordHash            String?
  razonSocial             String?
  Cart                    Cart[]
  Empresa                 Empresa                   @relation(fields: [empresaId], references: [id])
  ConversationParticipant ConversationParticipant[]
  CuentaCorriente         CuentaCorriente[]
  Deuda                   Deuda[]
  Legajo                  Legajo?
  Message                 Message[]
  MessageReadReceipt      MessageReadReceipt[]
  MessagingReadPreference MessagingReadPreference[]
  Pedido                  Pedido[]
  Venta                   Venta[]

  @@unique([empresaId, email])
  @@unique([id, empresaId])
}

model Compra {
  id                     String                @id
  empresaId              String
  proveedorId            String
  usuarioId              String
  estado                 EstadoCompra          @default(BORRADOR)
  total                  Decimal
  fechaOrden             DateTime              @default(now())
  fechaRecepcionEsperada DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime
  fechaVencimientoPago   DateTime?
  numeroFactura          String?
  saldo                  Decimal               @default(0)
  totalPagado            Decimal               @default(0)
  Empresa                Empresa               @relation(fields: [empresaId], references: [id])
  Proveedor              Proveedor             @relation(fields: [proveedorId], references: [id])
  Usuario                Usuario               @relation(fields: [usuarioId], references: [id])
  CompraItem             CompraItem[]
  DevolucionProveedor    DevolucionProveedor[]
  PagoProveedor          PagoProveedor[]
  RecepcionCompra        RecepcionCompra[]
}

model CompraItem {
  id               String   @id
  compraId         String
  productoId       String
  cantidadPedida   Decimal
  cantidadRecibida Decimal  @default(0)
  costoUnitario    Decimal
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  Compra           Compra   @relation(fields: [compraId], references: [id])
  Producto         Producto @relation(fields: [productoId], references: [id])
}

model Conversation {
  id                      String                    @id
  businessId              String
  type                    MessagingConversationType
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  deletedAt               DateTime?
  Empresa                 Empresa                   @relation(fields: [businessId], references: [id])
  ConversationAssociation ConversationAssociation[]
  ConversationParticipant ConversationParticipant[]
  Message                 Message[]

  @@unique([id, businessId])
  @@index([businessId, deletedAt])
  @@index([businessId, updatedAt])
}

model ConversationAssociation {
  id             String                   @id
  conversationId String
  businessId     String
  entityType     MessagingAssociationType
  entityId       String
  active         Boolean                  @default(true)
  changedBy      String?
  reason         String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime
  Conversation   Conversation             @relation(fields: [conversationId, businessId], references: [id, businessId])

  @@index([businessId, conversationId, active])
  @@index([businessId, entityType, entityId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ConversationParticipant {
  id                   String       @id
  conversationId       String
  businessId           String
  userId               String?
  membershipBusinessId String?
  customerId           String?
  customerBusinessId   String?
  joinedAt             DateTime     @default(now())
  leftAt               DateTime?
  removedAt            DateTime?
  isAdmin              Boolean      @default(false)
  Conversation         Conversation @relation(fields: [conversationId, businessId], references: [id, businessId])
  Cliente              Cliente?     @relation(fields: [customerId, customerBusinessId], references: [id, empresaId])
  Membership           Membership?  @relation(fields: [userId, membershipBusinessId], references: [userId, businessId])

  @@index([businessId, customerId])
  @@index([businessId, userId])
  @@index([conversationId, joinedAt])
  @@index([conversationId, leftAt])
}

model CuentaCorriente {
  id        String   @id
  empresaId String
  clienteId String
  saldo     Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
  Cliente   Cliente  @relation(fields: [clienteId], references: [id])
  Empresa   Empresa  @relation(fields: [empresaId], references: [id])
  Deuda     Deuda[]
  Pago      Pago[]

  @@unique([empresaId, clienteId])
}

model Deuda {
  id                String           @id
  empresaId         String
  clienteId         String
  ventaId           String?
  montoTotal        Decimal
  montoPendiente    Decimal
  fechaVencimiento  DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime
  cuentaCorrienteId String?
  AplicacionPago    AplicacionPago[]
  Cliente           Cliente          @relation(fields: [clienteId], references: [id])
  CuentaCorriente   CuentaCorriente? @relation(fields: [cuentaCorrienteId], references: [id])
  Empresa           Empresa          @relation(fields: [empresaId], references: [id])
  Venta             Venta?           @relation(fields: [ventaId], references: [id])
}

model DevolucionProveedor {
  id                      String                    @id
  empresaId               String
  compraId                String
  proveedorId             String
  usuarioId               String
  motivo                  String
  fecha                   DateTime                  @default(now())
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  Compra                  Compra                    @relation(fields: [compraId], references: [id])
  Empresa                 Empresa                   @relation(fields: [empresaId], references: [id])
  Proveedor               Proveedor                 @relation(fields: [proveedorId], references: [id])
  Usuario                 Usuario                   @relation(fields: [usuarioId], references: [id])
  DevolucionProveedorItem DevolucionProveedorItem[]
}

model DevolucionProveedorItem {
  id                  String              @id
  devolucionId        String
  productoId          String
  loteId              String?
  cantidad            Decimal
  costoUnitario       Decimal
  DevolucionProveedor DevolucionProveedor @relation(fields: [devolucionId], references: [id])
  Lote                Lote?               @relation(fields: [loteId], references: [id])
  Producto            Producto            @relation(fields: [productoId], references: [id])
}

model DocumentoLegajo {
  id            String              @id
  legajoId      String
  tipo          TipoDocumentoLegajo
  rutaArchivo   String
  nombreArchivo String
  vencimiento   DateTime
  createdAt     DateTime            @default(now())
  updatedAt     DateTime
  Legajo        Legajo              @relation(fields: [legajoId], references: [id])
}

model Empresa {
  id                      String                    @id
  nombre                  String                    @unique
  configuracion           Json
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  slug                    String                    @unique
  AuditLog                AuditLog[]
  Autorizacion            Autorizacion[]
  Caja                    Caja?
  Cart                    Cart[]
  Cliente                 Cliente[]
  Compra                  Compra[]
  Conversation            Conversation[]
  CuentaCorriente         CuentaCorriente[]
  Deuda                   Deuda[]
  DevolucionProveedor     DevolucionProveedor[]
  Entrega                 Entrega[]
  Familia                 Familia[]
  Invitacion              Invitacion[]
  Lote                    Lote[]
  Membership              Membership[]
  MessageReadReceipt      MessageReadReceipt[]
  MessagingReadPreference MessagingReadPreference[]
  MovimientoStock         MovimientoStock[]
  Notificacion            Notificacion[]
  Pago                    Pago[]
  PagoProveedor           PagoProveedor[]
  Pedido                  Pedido[]
  Presentacion            Presentacion[]
  Producto                Producto[]
  ProductoProveedor       ProductoProveedor[]
  Proveedor               Proveedor[]
  RecepcionCompra         RecepcionCompra[]
  ReglaFidelizacion       ReglaFidelizacion[]
  Subfamilia              Subfamilia[]
  Subtipo                 Subtipo[]
  Tipo                    Tipo[]
  Usuario                 Usuario[]
  Venta                   Venta[]
}

model Entrega {
  id                                    String    @id
  empresaId                             String
  pedidoId                              String    @unique
  preparadorId                          String?
  repartidorId                          String?
  resultado                             String?
  medioCobro                            String?
  fechaEntrega                          DateTime?
  createdAt                             DateTime  @default(now())
  updatedAt                             DateTime
  Empresa                               Empresa   @relation(fields: [empresaId], references: [id])
  Pedido                                Pedido    @relation(fields: [pedidoId], references: [id])
  Usuario_Entrega_preparadorIdToUsuario Usuario?  @relation("Entrega_preparadorIdToUsuario", fields: [preparadorId], references: [id])
  Usuario_Entrega_repartidorIdToUsuario Usuario?  @relation("Entrega_repartidorIdToUsuario", fields: [repartidorId], references: [id])
}

model Familia {
  id                String              @id
  empresaId         String
  nombre            String
  prefijo           String              @db.Char(3)
  activo            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  Empresa           Empresa             @relation(fields: [empresaId], references: [id])
  Producto          Producto[]
  ReglaFidelizacion ReglaFidelizacion[]
  Subfamilia        Subfamilia[]

  @@unique([empresaId, nombre])
  @@unique([empresaId, prefijo])
}

model Invitacion {
  id            String     @id
  empresaId     String
  email         String
  rol           RolUsuario
  token         String     @unique
  invitadoPorId String
  expiraEn      DateTime
  usadaEn       DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime
  Empresa       Empresa    @relation(fields: [empresaId], references: [id])
  Usuario       Usuario    @relation(fields: [invitadoPorId], references: [id])
}

model Legajo {
  id               String            @id
  usuarioId        String?           @unique
  clienteId        String?           @unique
  cuit             String?
  razonSocial      String?
  condicionIva     String?
  tipoFactura      String?
  dni              String?
  telefono         String?
  direccion        String?
  vehiculoDatos    String?
  licenciaConducir String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  DocumentoLegajo  DocumentoLegajo[]
  Cliente          Cliente?          @relation(fields: [clienteId], references: [id])
  Usuario          Usuario?          @relation(fields: [usuarioId], references: [id])
}

model Lote {
  id                      String                    @id
  empresaId               String
  productoId              String
  numeroLote              String
  vencimiento             DateTime
  cantidad                Decimal
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  DevolucionProveedorItem DevolucionProveedorItem[]
  Empresa                 Empresa                   @relation(fields: [empresaId], references: [id])
  Producto                Producto                  @relation(fields: [productoId], references: [id])
  MovimientoStock         MovimientoStock[]

  @@unique([productoId, numeroLote, empresaId])
}

model Membership {
  id                      String                    @id
  userId                  String
  businessId              String
  role                    RolUsuario
  status                  MembershipStatus          @default(ACTIVE)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  ConversationParticipant ConversationParticipant[]
  Empresa                 Empresa                   @relation(fields: [businessId], references: [id])
  User                    User                      @relation(fields: [userId], references: [id])
  Message                 Message[]
  MessageReadReceipt      MessageReadReceipt[]
  MessagingReadPreference MessagingReadPreference[]
  RoleGrant               RoleGrant?

  @@unique([userId, businessId])
  @@index([businessId, userId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Message {
  id                         String               @id
  conversationId             String
  businessId                 String
  authorUserId               String?
  authorMembershipBusinessId String?
  authorCustomerId           String?
  authorCustomerBusinessId   String?
  sequence                   BigInt
  clientMessageId            String
  type                       MessagingMessageType
  content                    String?
  createdAt                  DateTime             @default(now())
  deliveredAt                DateTime?
  readAt                     DateTime?
  editedAt                   DateTime?
  deletedAt                  DateTime?
  deletedByUserId            String?
  replyToMessageId           String?
  Attachment                 Attachment[]
  Cliente                    Cliente?             @relation(fields: [authorCustomerId, authorCustomerBusinessId], references: [id, empresaId])
  Membership                 Membership?          @relation(fields: [authorUserId, authorMembershipBusinessId], references: [userId, businessId])
  Conversation               Conversation         @relation(fields: [conversationId, businessId], references: [id, businessId])
  MessageReadReceipt         MessageReadReceipt[]
  Reaction                   Reaction[]

  @@unique([conversationId, clientMessageId, authorCustomerId])
  @@unique([conversationId, clientMessageId, authorUserId])
  @@unique([conversationId, sequence])
  @@unique([id, businessId])
  @@index([businessId, conversationId, createdAt])
  @@index([conversationId, deletedAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model MessageReadReceipt {
  id                   String      @id
  messageId            String
  businessId           String
  userId               String?
  membershipBusinessId String?
  customerId           String?
  customerBusinessId   String?
  readAt               DateTime    @default(now())
  Empresa              Empresa     @relation(fields: [businessId], references: [id])
  Cliente              Cliente?    @relation(fields: [customerId, customerBusinessId], references: [id, empresaId])
  Message              Message     @relation(fields: [messageId, businessId], references: [id, businessId])
  Membership           Membership? @relation(fields: [userId, membershipBusinessId], references: [userId, businessId])

  @@unique([messageId, customerId])
  @@unique([messageId, userId])
  @@index([businessId, customerId])
  @@index([businessId, messageId])
  @@index([businessId, userId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model MessagingReadPreference {
  id                   String      @id
  businessId           String
  userId               String?
  membershipBusinessId String?
  customerId           String?
  customerBusinessId   String?
  enabled              Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime
  Empresa              Empresa     @relation(fields: [businessId], references: [id])
  Cliente              Cliente?    @relation(fields: [customerId, customerBusinessId], references: [id, empresaId])
  Membership           Membership? @relation(fields: [userId, membershipBusinessId], references: [userId, businessId])

  @@unique([customerId, businessId])
  @@unique([userId, businessId])
  @@index([businessId, customerId])
  @@index([businessId, userId])
}

model MovimientoCaja {
  id             String        @id
  cajaId         String
  aperturaCajaId String?
  usuarioId      String
  tipo           String
  monto          Decimal
  descripcion    String?
  referenciaId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  AperturaCaja   AperturaCaja? @relation(fields: [aperturaCajaId], references: [id])
  Caja           Caja          @relation(fields: [cajaId], references: [id])
  Usuario        Usuario       @relation(fields: [usuarioId], references: [id])
}

model MovimientoStock {
  id                   String           @id
  empresaId            String
  productoId           String
  loteId               String?
  tipoMovimiento       String
  cantidad             Decimal
  motivo               String
  referenciaId         String?
  usuarioId            String?
  recepcionCompraId    String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime
  loteVencidoAlMomento Boolean          @default(false)
  Empresa              Empresa          @relation(fields: [empresaId], references: [id])
  Lote                 Lote?            @relation(fields: [loteId], references: [id])
  Producto             Producto         @relation(fields: [productoId], references: [id])
  RecepcionCompra      RecepcionCompra? @relation(fields: [recepcionCompraId], references: [id])
  Usuario              Usuario?         @relation(fields: [usuarioId], references: [id])
}

model Notificacion {
  id           String   @id
  empresaId    String
  pedidoId     String?
  evento       String
  canal        String
  destinatario String
  estadoEnvio  String
  mensaje      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Empresa      Empresa  @relation(fields: [empresaId], references: [id])
  Pedido       Pedido?  @relation(fields: [pedidoId], references: [id])
}

model Pago {
  id              String           @id
  empresaId       String
  usuarioId       String?
  ventaId         String?
  deudaId         String?
  monto           Decimal
  medio           String
  estado          EstadoPago       @default(PENDIENTE)
  comision        Decimal          @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  pedidoId        String?
  montoRecibido   Decimal?
  vuelto          Decimal?
  referencia      String?
  AplicacionPago  AplicacionPago[]
  CuentaCorriente CuentaCorriente? @relation(fields: [deudaId], references: [id])
  Empresa         Empresa          @relation(fields: [empresaId], references: [id])
  Pedido          Pedido?          @relation(fields: [pedidoId], references: [id])
  Usuario         Usuario?         @relation(fields: [usuarioId], references: [id])
  Venta           Venta?           @relation(fields: [ventaId], references: [id])
}

model PagoProveedor {
  id          String    @id
  empresaId   String
  compraId    String
  proveedorId String
  usuarioId   String
  monto       Decimal
  medioPago   String
  referencia  String?
  fecha       DateTime  @default(now())
  notas       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Compra      Compra    @relation(fields: [compraId], references: [id])
  Empresa     Empresa   @relation(fields: [empresaId], references: [id])
  Proveedor   Proveedor @relation(fields: [proveedorId], references: [id])
  Usuario     Usuario   @relation(fields: [usuarioId], references: [id])
}

model Pedido {
  id             String         @id
  empresaId      String
  clienteId      String
  usuarioId      String?
  estado         EstadoPedido   @default(RECIBIDO)
  canalOrigen    String
  total          Decimal
  descuento      Decimal        @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  idempotencyKey String?
  Entrega        Entrega?
  Notificacion   Notificacion[]
  Pago           Pago[]
  Cliente        Cliente        @relation(fields: [clienteId], references: [id])
  Empresa        Empresa        @relation(fields: [empresaId], references: [id])
  Usuario        Usuario?       @relation(fields: [usuarioId], references: [id])
  PedidoItem     PedidoItem[]
}

model PedidoItem {
  id                              String             @id
  pedidoId                        String
  productoId                      String
  cantidad                        Decimal
  precioUnitario                  Decimal
  descuentoItem                   Decimal            @default(0)
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime
  descuentoFidelizacionPorcentaje Decimal?           @db.Decimal(5, 2)
  reglaFidelizacionId             String?
  Pedido                          Pedido             @relation(fields: [pedidoId], references: [id])
  Producto                        Producto           @relation(fields: [productoId], references: [id])
  ReglaFidelizacion               ReglaFidelizacion? @relation(fields: [reglaFidelizacionId], references: [id], onDelete: Restrict)
}

model Permiso {
  id             String           @id
  nombre         String           @unique
  descripcion    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  UsuarioPermiso UsuarioPermiso[]
}

model Presentacion {
  id               String   @id
  empresaId        String
  productoId       String
  nombre           String
  factorConversion Decimal
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  Empresa          Empresa  @relation(fields: [empresaId], references: [id])
  Producto         Producto @relation(fields: [productoId], references: [id])

  @@unique([productoId, nombre])
}

model Producto {
  id                      String                    @id
  empresaId               String
  nombre                  String
  codigoInterno           String
  codigoBarras            String?
  marca                   String?
  unidadBase              UnidadBase
  costo                   Decimal
  precioMinorista         Decimal
  precioMayorista         Decimal?
  activo                  Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  stockMinimo             Decimal                   @default(0)
  descuentoPorcentaje     Decimal?                  @db.Decimal(5, 2)
  familiaId               String
  subfamiliaId            String
  tipoId                  String
  subtipoId               String
  CartItem                CartItem[]
  CompraItem              CompraItem[]
  DevolucionProveedorItem DevolucionProveedorItem[]
  Lote                    Lote[]
  MovimientoStock         MovimientoStock[]
  PedidoItem              PedidoItem[]
  Presentacion            Presentacion[]
  Empresa                 Empresa                   @relation(fields: [empresaId], references: [id])
  Familia                 Familia                   @relation(fields: [familiaId], references: [id])
  Subfamilia              Subfamilia                @relation(fields: [subfamiliaId], references: [id])
  Subtipo                 Subtipo                   @relation(fields: [subtipoId], references: [id])
  Tipo                    Tipo                      @relation(fields: [tipoId], references: [id])
  ProductoProveedor       ProductoProveedor[]
  VentaItem               VentaItem[]

  @@unique([empresaId, codigoInterno])
}

model ProductoProveedor {
  id          String    @id
  empresaId   String
  productoId  String
  proveedorId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Empresa     Empresa   @relation(fields: [empresaId], references: [id])
  Producto    Producto  @relation(fields: [productoId], references: [id])
  Proveedor   Proveedor @relation(fields: [proveedorId], references: [id])

  @@unique([productoId, proveedorId])
}

model Proveedor {
  id                  String                @id
  empresaId           String
  nombre              String
  email               String?
  telefono            String?
  direccion           String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  Compra              Compra[]
  DevolucionProveedor DevolucionProveedor[]
  PagoProveedor       PagoProveedor[]
  ProductoProveedor   ProductoProveedor[]
  Empresa             Empresa               @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, nombre])
}

model Reaction {
  id        String   @id
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  Message   Message  @relation(fields: [messageId], references: [id])
  User      User     @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
  @@index([userId, messageId])
}

model RecepcionCompra {
  id              String            @id
  empresaId       String
  compraId        String
  usuarioId       String
  fechaRecepcion  DateTime          @default(now())
  observaciones   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  MovimientoStock MovimientoStock[]
  Compra          Compra            @relation(fields: [compraId], references: [id])
  Empresa         Empresa           @relation(fields: [empresaId], references: [id])
  Usuario         Usuario           @relation(fields: [usuarioId], references: [id])
}

model ReglaFidelizacion {
  id                  String         @id
  empresaId           String
  nombre              String
  nivelRequerido      NivelFidelidad
  descuentoPorcentaje Decimal        @db.Decimal(5, 2)
  marca               String?
  cantidadMinima      Int?
  activo              Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime
  familiaId           String?
  subfamiliaId        String?
  tipoId              String?
  subtipoId           String?
  PedidoItem          PedidoItem[]
  Empresa             Empresa        @relation(fields: [empresaId], references: [id])
  Familia             Familia?       @relation(fields: [familiaId], references: [id])
  Subfamilia          Subfamilia?    @relation(fields: [subfamiliaId], references: [id])
  Subtipo             Subtipo?       @relation(fields: [subtipoId], references: [id])
  Tipo                Tipo?          @relation(fields: [tipoId], references: [id])
  VentaItem           VentaItem[]
}

model RoleCapability {
  id                   String               @id
  roleTemplateId       String
  capabilityDefId      String
  createdAt            DateTime             @default(now())
  CapabilityDefinition CapabilityDefinition @relation(fields: [capabilityDefId], references: [id])
  RoleTemplate         RoleTemplate         @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)

  @@unique([roleTemplateId, capabilityDefId])
  @@index([roleTemplateId])
}

model RoleGrant {
  id              String            @id
  membershipId    String            @unique
  roleTemplateId  String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  CapabilityGrant CapabilityGrant[]
  Membership      Membership        @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  RoleTemplate    RoleTemplate      @relation(fields: [roleTemplateId], references: [id])

  @@index([membershipId])
}

model RoleTemplate {
  id             String           @id
  name           String           @unique
  description    String?
  empresaId      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  RoleCapability RoleCapability[]
  RoleGrant      RoleGrant[]
}

model Subfamilia {
  id                String              @id
  empresaId         String
  familiaId         String
  nombre            String
  prefijo           String              @db.Char(3)
  activo            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  Producto          Producto[]
  ReglaFidelizacion ReglaFidelizacion[]
  Empresa           Empresa             @relation(fields: [empresaId], references: [id])
  Familia           Familia             @relation(fields: [familiaId], references: [id])
  Tipo              Tipo[]

  @@unique([familiaId, nombre])
  @@unique([familiaId, prefijo])
}

model Subtipo {
  id                String              @id
  empresaId         String
  tipoId            String
  nombre            String
  prefijo           String              @db.Char(3)
  activo            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  Producto          Producto[]
  ReglaFidelizacion ReglaFidelizacion[]
  Empresa           Empresa             @relation(fields: [empresaId], references: [id])
  Tipo              Tipo                @relation(fields: [tipoId], references: [id])

  @@unique([tipoId, nombre])
  @@unique([tipoId, prefijo])
}

model Tipo {
  id                String              @id
  empresaId         String
  subfamiliaId      String
  nombre            String
  prefijo           String              @db.Char(3)
  activo            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  Producto          Producto[]
  ReglaFidelizacion ReglaFidelizacion[]
  Subtipo           Subtipo[]
  Empresa           Empresa             @relation(fields: [empresaId], references: [id])
  Subfamilia        Subfamilia          @relation(fields: [subfamiliaId], references: [id])

  @@unique([subfamiliaId, nombre])
  @@unique([subfamiliaId, prefijo])
}

model User {
  id           String       @id
  email        String       @unique
  nombre       String
  passwordHash String?
  googleId     String?      @unique
  fotoUrl      String?
  usuarioId    String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  Membership   Membership[]
  Reaction     Reaction[]
}

model Usuario {
  id                                               String                @id
  empresaId                                        String
  nombre                                           String
  email                                            String                @unique
  passwordHash                                     String?
  activo                                           Boolean               @default(true)
  createdAt                                        DateTime              @default(now())
  updatedAt                                        DateTime
  fotoUrl                                          String?
  googleId                                         String?               @unique
  estadoLegajo                                     EstadoLegajo          @default(APROBADO)
  rol                                              RolUsuario            @default(OWNER)
  AperturaCaja                                     AperturaCaja[]
  ArqueoCaja_ArqueoCaja_usuarioEntranteIdToUsuario ArqueoCaja[]          @relation("ArqueoCaja_usuarioEntranteIdToUsuario")
  ArqueoCaja_ArqueoCaja_usuarioIdToUsuario         ArqueoCaja[]          @relation("ArqueoCaja_usuarioIdToUsuario")
  AuditLog                                         AuditLog[]
  Autorizacion                                     Autorizacion[]
  CierreCaja                                       CierreCaja[]
  Compra                                           Compra[]
  DevolucionProveedor                              DevolucionProveedor[]
  Entrega_Entrega_preparadorIdToUsuario            Entrega[]             @relation("Entrega_preparadorIdToUsuario")
  Entrega_Entrega_repartidorIdToUsuario            Entrega[]             @relation("Entrega_repartidorIdToUsuario")
  Invitacion                                       Invitacion[]
  Legajo                                           Legajo?
  MovimientoCaja                                   MovimientoCaja[]
  MovimientoStock                                  MovimientoStock[]
  Pago                                             Pago[]
  PagoProveedor                                    PagoProveedor[]
  Pedido                                           Pedido[]
  RecepcionCompra                                  RecepcionCompra[]
  Empresa                                          Empresa               @relation(fields: [empresaId], references: [id])
  UsuarioPermiso                                   UsuarioPermiso[]
  Venta                                            Venta[]
}

model UsuarioPermiso {
  id        String   @id
  usuarioId String
  permisoId String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Permiso   Permiso  @relation(fields: [permisoId], references: [id])
  Usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, permisoId])
}

model Venta {
  id             String      @id
  empresaId      String
  usuarioId      String
  clienteId      String?
  canal          String
  total          Decimal     @db.Decimal(14, 2)
  descuento      Decimal     @default(0) @db.Decimal(14, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime
  estado         EstadoVenta @default(CONFIRMADA)
  idempotencyKey String?     @unique
  numero         Int?
  AuditLog       AuditLog[]
  Deuda          Deuda[]
  Pago           Pago[]
  Cliente        Cliente?    @relation(fields: [clienteId], references: [id])
  Empresa        Empresa     @relation(fields: [empresaId], references: [id])
  Usuario        Usuario     @relation(fields: [usuarioId], references: [id])
  VentaItem      VentaItem[]

  @@index([empresaId, numero])
}

model VentaItem {
  id                              String             @id
  ventaId                         String
  productoId                      String
  cantidad                        Decimal            @db.Decimal(14, 2)
  precioUnitario                  Decimal            @db.Decimal(14, 2)
  descuentoItem                   Decimal            @default(0) @db.Decimal(14, 2)
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime
  descuentoFidelizacionPorcentaje Decimal?           @db.Decimal(5, 2)
  reglaFidelizacionId             String?
  Producto                        Producto           @relation(fields: [productoId], references: [id])
  ReglaFidelizacion               ReglaFidelizacion? @relation(fields: [reglaFidelizacionId], references: [id], onDelete: Restrict)
  Venta                           Venta              @relation(fields: [ventaId], references: [id])
}

