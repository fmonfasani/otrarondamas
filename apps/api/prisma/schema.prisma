  productoId          String
  loteId              String?
  cantidad            Decimal             @db.Decimal(18, 4)
  costoUnitario       Decimal             @db.Decimal(18, 4)
  DevolucionProveedor DevolucionProveedor @relation(fields: [empresaId, devolucionId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Lote                Lote?               @relation(fields: [empresaId, loteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Producto            Producto            @relation(fields: [empresaId, productoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
}

model DocumentoLegajo {
