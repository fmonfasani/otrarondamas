/// Notification Preferences - User notification settings and delivery preferences
model NotificationPreference {
  id                        String                   @id @default(uuid())
  usuarioId                 String
  empresaId                 String

  /// Channel settings
  pushEnabled               Boolean                  @default(true)
  emailEnabled              Boolean                  @default(true)
  smsEnabled                Boolean                  @default(false)

  /// Frequency settings (per notification type)
  orderNotifications        NotificationFrequency    @default(REAL_TIME)
  messageNotifications      NotificationFrequency    @default(REAL_TIME)
  inventoryNotifications    NotificationFrequency    @default(DAILY)
  systemNotifications       NotificationFrequency    @default(REAL_TIME)

  /// Quiet hours (24-hour format HH:MM)
  quietHoursEnabled         Boolean                  @default(false)
  quietHoursStart           String?                  /// "22:00"
  quietHoursEnd             String?                  /// "08:00"

  /// Digest settings
  digestFrequency           DigestPeriod             @default(DAILY)
  digestTime                String                   @default("09:00") /// preferred send time HH:MM

  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  Usuario                   Usuario                  @relation(fields: [usuarioId], references: [id])
  Empresa                   Empresa                  @relation(fields: [empresaId], references: [id])

  @@unique([usuarioId, empresaId])
  @@index([empresaId, usuarioId])
}

/// Notification Digest - Batched notifications sent at scheduled intervals
model NotificationDigest {
  id                String      @id @default(uuid())
  usuarioId         String
  empresaId         String
  period            DigestPeriod
  startDate         DateTime
  endDate           DateTime
  summary           Json        /// { orders: 5, messages: 12, inventory: 3 }
  content           String      /// HTML digest content
  sentAt            DateTime?
  openedAt          DateTime?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  Usuario           Usuario     @relation(fields: [usuarioId], references: [id])
  Empresa           Empresa     @relation(fields: [empresaId], references: [id])

  @@index([empresaId, usuarioId, period])
  @@index([usuarioId, sentAt])
}

