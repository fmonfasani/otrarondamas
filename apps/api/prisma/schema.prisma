  empresaId     String
  legajoId      String
  tipo          TipoDocumentoLegajo
  rutaArchivo   String
  nombreArchivo String
  vencimiento   DateTime
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  Legajo        Legajo              @relation(fields: [empresaId, legajoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
