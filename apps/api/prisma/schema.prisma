  CERRADA
  ABIERTA
  EN_ARQUEO
}

enum EstadoCompra {
  BORRADOR
  EMITIDA
  RECEPCION_PARCIAL
  RECIBIDA
}

enum EstadoLegajo {
  PENDIENTE
  APROBADO
}

enum EstadoPago {
  PENDIENTE
  EN_PROCESO
  APROBADO
  RECHAZADO
  CANCELADO
  REEMBOLSADO_PARCIAL
  REEMBOLSADO_TOTAL
}

enum EstadoPedido {
  RECIBIDO
  CONFIRMADO
  EN_PREPARACION
  LISTO
  ASIGNADO
  EN_CAMINO
  ENTREGADO
  PARCIALMENTE_ENTREGADO
  ENTREGA_FALLIDA
  CANCELADO
}

enum EstadoVenta {
  CONFIRMADA
  ANULADA
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum MessagingAssociationType {
  CUSTOMER
  ORDER
  SALE
  PRODUCT
  PURCHASE
}

enum MessagingConversationType {
  DIRECT
  GROUP
}

enum MessagingMessageType {
  TEXT
  IMAGE
  FILE
  VOICE
}

enum NivelFidelidad {
  NUEVO
  FRECUENTE
  VIP
}

enum RolUsuario {
  OWNER
  ASISTENTE_LOCAL
  PROVEEDOR
  REPARTIDOR
}

enum TipoDocumentoLegajo {
  ANTECEDENTES_PENALES
  CONSTANCIA_CUIL
}

enum UnidadBase {
  UNIDAD
  KILOGRAMO
  LITRO
