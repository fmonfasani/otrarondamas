  LOGIN
  PAYMENT
  ACCOUNT_VERIFICATION
  PASSWORD_RESET
}

model PhoneNumber {
  id                    String      @id @default(uuid())
  usuarioId             String?
  clienteId             String?
  empresaId             String
  phoneNumber           String
  countryCode           String      @default("+54") // Argentina by default
  isVerified            Boolean     @default(false)
  isPrimary             Boolean     @default(false)
  verificationCode      String?
  verificationCodeExpires DateTime?
  lastUsedAt            DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  Usuario               Usuario?    @relation(fields: [usuarioId], references: [id])
  Cliente               Cliente?    @relation(fields: [clienteId], references: [id])
  Empresa               Empresa     @relation(fields: [empresaId], references: [id])
  smsLogs               SMSLog[]
  otpSessions           OTPSession[]
  smsAlerts             SMSAlert[]

  @@unique([empresaId, phoneNumber])
  @@index([usuarioId])
  @@index([clienteId])
  @@index([empresaId])
}

model OTPSession {
  id                    String      @id @default(uuid())
  phoneNumberId         String
  purpose               OTPPurpose
  code                  String
  attempts              Int         @default(0)
  maxAttempts           Int         @default(3)
  expiresAt             DateTime
  verifiedAt            DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  phoneNumber           PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)

  @@index([phoneNumberId])
  @@index([expiresAt])
}

model SMSLog {
  id                    String      @id @default(uuid())
  phoneNumberId         String
  toPhone               String      @db.VarChar(20)
  message               String      @db.VarChar(160)
  type                  SMSType
  status                SMSStatus   @default(PENDING)
  twilioSid             String?     @unique
  errorCode             String?
  errorMessage          String?
  sentAt                DateTime    @default(now())
  deliveredAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  phoneNumber           PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)

  @@index([phoneNumberId])
  @@index([status])
  @@index([createdAt])
  @@index([twilioSid])
}

model SMSAlert {
  id                    String      @id @default(uuid())
  empresaId             String
  usuarioId             String?
  clienteId             String?
  trigger               String      // "order_confirmation", "inventory_low", "payment_received", etc
  message               String
  isActive              Boolean     @default(true)
  phoneNumberId         String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  Empresa               Empresa     @relation(fields: [empresaId], references: [id])
  Usuario               Usuario?    @relation(fields: [usuarioId], references: [id])
  Cliente               Cliente?    @relation(fields: [clienteId], references: [id])
  PhoneNumber           PhoneNumber? @relation(fields: [phoneNumberId], references: [id])

  @@index([empresaId])
  @@index([usuarioId])
  @@index([clienteId])
}

// P8-2: Email Notifications models
model EmailTemplate {
  id            String    @id @default(uuid())
  empresaId     String
  nombre        String
  tipo          TipoEmail @default(TRANSACCIONAL)
  asunto        String
  contenidoHtml String    // Handlebars template: {{variable}}
  variables     Json?     // Schema: {"required": ["userId"], "optional": ["orderId"]}
  activo        Boolean   @default(true)
  versionActual Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  Empresa       Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  EmailLog      EmailLog[]
  EmailCampaign EmailCampaign[]

  @@unique([empresaId, nombre, versionActual])
  @@index([empresaId, tipo, activo])
}

model EmailLog {
  id                String      @id @default(uuid())
  empresaId         String
  templateId        String?
  destinatario      String
  asunto            String
  contenido         String?     // Rendered HTML
  evento            String      @default("ENVIADO")  // ENVIADO, ABIERTO, CLICK, REBOTE, QUEJA
  proveedor         String      @default("RESEND")   // RESEND, SENDGRID, SES
  providerMessageId String?     @unique             // Provider's message ID for tracking
  metadata          Json?       // tracking: {openedAt, clicks: [{url, clickedAt}]}
  idReferencia      String?     // orderId, ventaId, etc
  tipoReferencia    String?     // "Venta", "Pedido", "Invitacion"
  intentos          Int         @default(1)
  errorMensaje      String?
  proxRetento       DateTime?   // Null = no retry needed
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  Empresa           Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  EmailTemplate     EmailTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([empresaId, destinatario, createdAt])
  @@index([empresaId, tipoReferencia, idReferencia])
  @@index([proveedor, providerMessageId])
  @@index([proxRetento])  // For retry queries
}

model EmailPreference {
  id            String      @id @default(uuid())
  empresaId     String
  usuarioId     String?     @unique
  clienteId     String?     @unique // For non-staff customers
  email         String
  categoriasOptIn Json?     // {"transaccional": true, "marketing": true, "newsletters": false}
  frecuencia    String      @default("TODAS")  // TODAS, SEMANAL, MENSUAL, NUNCA
  suscrito      Boolean     @default(true)
  desuscritaEn  DateTime?
  motivoDesuscripcion String?
  unsubscribeToken String   @unique @db.VarChar(128)  // For anonymous unsubscribe links
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  Empresa       Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  Usuario       Usuario?  @relation("EmailPreference_usuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  Cliente       Cliente?  @relation("EmailPreference_cliente", fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([empresaId, email])
  @@index([empresaId, suscrito])
  @@index([empresaId, desuscritaEn])
}

model EmailCampaign {
  id              String           @id @default(uuid())
  empresaId       String
  templateId      String
  nombre          String
  descripcion     String?
  estadio         EstadoCampaign   @default(BORRADOR)
  audiencia       String           @default("CLIENTES")  // CLIENTES, USUARIOS, SUSCRIPTORES, MANUAL
  filtroAudiencia Json?            // {status: "ACTIVO", createdAfter: "2024-01-01"}
  programadaPara  DateTime?
  iniciadaEn      DateTime?
  finalizadaEn    DateTime?
  destinatariosTotal Int?
  destinatariosEnviados Int         @default(0)
  destinatariosFallidos Int         @default(0)
  tasaApertura    Decimal?         @db.Decimal(5, 2)
  tasaClick       Decimal?         @db.Decimal(5, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  Empresa         Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  EmailTemplate   EmailTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([empresaId, estadio])
  @@index([empresaId, programadaPara])
  @@index([empresaId, iniciadaEn])
}

// P8-2: Email enums
enum TipoEmail {
  TRANSACCIONAL   // Order confirmations, password reset, invitations
  MARKETING       // Promotions, newsletters
  ALERTAS         // Stock alerts, payment reminders
}

enum EstadoCampaign {
  BORRADOR
  PROGRAMADA
  ENVIANDO
  COMPLETADA
  CANCELADA
}

// P11-1: Payment Gateway Models
model Payment {
  id                String     @id @default(cuid())
  empresaId         String
  empresa           Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  ventaId           String
  venta             Venta      @relation(fields: [ventaId], references: [id], onDelete: Restrict)

  monto             Decimal    @db.Decimal(10, 2)
  moneda            String     @default("ARS")

  proveedor         String     // "STRIPE" | "MERCADOPAGO"
  providerPaymentId String     @unique

  estado            String     @default("PENDING")  // "PENDING" | "COMPLETED" | "FAILED" | "CANCELLED"

  metodo            String?    // "CARD" | "BANK_TRANSFER" | "QR" | "WALLET"
  ultimosDigitos    String?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  PaymentIntent     PaymentIntent[]
  Refund            Refund[]

  @@index([empresaId, estado])
  @@index([ventaId])
  @@index([empresaId, createdAt])
}

model PaymentIntent {
  id                String     @id @default(cuid())
  empresaId         String
  empresa           Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  paymentId         String
  payment           Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  clientSecret      String     @unique
  providerIntentId  String     @unique

  metadata          Json?

  createdAt         DateTime   @default(now())
  expiresAt         DateTime

  @@index([empresaId, expiresAt])
  @@index([paymentId])
}

model PaymentWebhook {
  id                String     @id @default(cuid())
  empresaId         String
  empresa           Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  tipo              String     // "payment.success" | "payment.failed" | "refund.completed" | etc
  providerEventId   String     @unique

  payload           Json

  processed         Boolean    @default(false)
  processedAt       DateTime?

  createdAt         DateTime   @default(now())

  @@index([empresaId, processed])
  @@index([empresaId, createdAt])
}

model Refund {
  id                String     @id @default(cuid())
  empresaId         String
  empresa           Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  paymentId         String
  payment           Payment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  monto             Decimal    @db.Decimal(10, 2)
  razon             String     // "CUSTOMER_REQUEST" | "MISTAKE" | "FRAUD_SUSPECTED" | "OTHER"

  estado            String     @default("PENDING")  // "PENDING" | "COMPLETED" | "FAILED"
  providerRefundId  String?    @unique

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([empresaId, estado])
  @@index([paymentId])
}

