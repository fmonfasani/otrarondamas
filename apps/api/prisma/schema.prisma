  Subtipo                 Subtipo[]
  Tipo                    Tipo[]
  Ubicacion               Ubicacion[]
  Oferta                  Oferta[]
  OfertaProducto          OfertaProducto[]
  Usuario                 Usuario[]
  UserEmpresa             UserEmpresa[]
  Venta                   Venta[]
  PhoneNumber             PhoneNumber[]
