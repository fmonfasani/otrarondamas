model AnalyticsEvent {
  id        String   @id @default(uuid())
  empresaId String
  userId    String?
  eventType String // 'PAGE_VIEW', 'CONVERSION', 'ERROR', 'PERFORMANCE', 'CUSTOM'
  eventName String // e.g., 'checkout_started', 'product_viewed'
  category  String? // e.g., 'sales', 'inventory', 'users'
  timestamp DateTime @default(now())
  metadata  Json? // {productId, quantity, value, customerId, orderId, errorMessage, duration, ...}
  sessionId String? // For session-based tracking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Empresa   Empresa  @relation(fields: [empresaId], references: [id])

  @@index([empresaId, eventType, timestamp])
  @@index([empresaId, userId, timestamp])
  @@index([sessionId])
}

model AnalyticsAggregation {
  id          String   @id @default(uuid())
  empresaId   String
  period      String // 'DAILY', 'WEEKLY', 'MONTHLY'
  periodStart DateTime
  periodEnd   DateTime
  eventType   String // 'PAGE_VIEW', 'CONVERSION', 'ERROR', 'PERFORMANCE'
  eventName   String? // NULL for aggregated by type
  count       Int
  uniqueUsers Int
  avgValue    Decimal? @db.Decimal(18, 2) // For conversions/revenue
  metadata    Json? // {topProducts, topPages, errorRate, ...}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Empresa     Empresa  @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, period, periodStart, eventType, eventName])
  @@index([empresaId, period, periodStart])
}

model AnalyticsDashboard {
  id              String   @id @default(uuid())
  empresaId       String
  name            String
  description     String?
  dashboardConfig Json // {widgets: [{type, metric, period, filters}]}
  isPublic        Boolean  @default(false)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  Empresa         Empresa  @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
}

model Entrega {
  id                                    String    @id @default(uuid())
  empresaId                             String
  pedidoId                              String    @unique
  preparadorId                          String?
  repartidorId                          String?
  resultado                             String?
  medioCobro                            String?
  fechaEntrega                          DateTime?
  createdAt                             DateTime  @default(now())
  updatedAt                             DateTime  @updatedAt
  Empresa                               Empresa   @relation(fields: [empresaId], references: [id])
  Pedido                                Pedido    @relation(fields: [empresaId, pedidoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Usuario_Entrega_preparadorIdToUsuario Usuario?  @relation("Entrega_preparadorIdToUsuario", fields: [empresaId, preparadorId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Usuario_Entrega_repartidorIdToUsuario Usuario?  @relation("Entrega_repartidorIdToUsuario", fields: [empresaId, repartidorId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([empresaId, pedidoId])
}

model Familia {
  id                String              @id @default(uuid())
  empresaId         String
  nombre            String
  prefijo           String              @db.Char(3)
  activo            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Empresa           Empresa             @relation(fields: [empresaId], references: [id])
  Producto          Producto[]
  ReglaFidelizacion ReglaFidelizacion[]
  Subfamilia        Subfamilia[]
  Oferta            Oferta[]

  @@unique([empresaId, nombre])
  @@unique([empresaId, prefijo])
  /// ADR-DAT-020: lets a new reference carry the business (Oferta, stage C3).
  @@unique([empresaId, id])
}

model Invitacion {
  id            String     @id @default(uuid())
  empresaId     String
  email         String
  rol           RolUsuario
  token         String     @unique
  invitadoPorId String
  expiraEn      DateTime
  usadaEn       DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  Empresa       Empresa    @relation(fields: [empresaId], references: [id])
  Usuario       Usuario    @relation(fields: [empresaId, invitadoPorId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
}

model Legajo {
  id               String            @id @default(uuid())
  empresaId        String
  usuarioId        String?           @unique
  clienteId        String?           @unique
  cuit             String?
  razonSocial      String?
  condicionIva     String?
  tipoFactura      String?
  dni              String?
  telefono         String?
  direccion        String?
  vehiculoDatos    String?
  licenciaConducir String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  DocumentoLegajo  DocumentoLegajo[]
  Cliente          Cliente?          @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  Usuario          Usuario?          @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  /// ADR-DAT-020 (Fase 2 PR 4, module 4c): references carry the business.
  @@unique([empresaId, id])
  @@unique([empresaId, usuarioId])
  @@unique([clienteId, empresaId])
}

model Lote {
  id                      String                    @id @default(uuid())
  empresaId               String
  productoId              String
  numeroLote              String
  /// Only for products that control expiry (OR-B4-046 rule 9); null for the rest.
  vencimiento             DateTime?
  cantidad                Decimal                   @db.Decimal(18, 4)
  /// OR-B4-015 / R8-INV-003 (#166): where the lot is. A lot created without a location goes to its
  /// business's main location (database trigger, migration 20261120010000), so every path that
  /// creates lots keeps working as it is.
  ubicacionId             String                    @default(dbgenerated())
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  DevolucionProveedorItem DevolucionProveedorItem[]
  Empresa                 Empresa                   @relation(fields: [empresaId], references: [id])
  Producto                Producto                  @relation(fields: [empresaId, productoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Ubicacion               Ubicacion                 @relation(fields: [empresaId, ubicacionId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  MovimientoStock         MovimientoStock[]

  @@unique([productoId, numeroLote, empresaId])
  @@unique([empresaId, id])
  @@index([ubicacionId])
}

model Membership {
  id                      String                    @id @default(uuid())
  userId                  String
  businessId              String
  role                    RolUsuario
  status                  MembershipStatus          @default(ACTIVE)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  /// E2b — when this person last left the panel of this business («últ. vez»).
  lastSeenAt              DateTime?
  ConversationParticipant ConversationParticipant[]
  Empresa                 Empresa                   @relation(fields: [businessId], references: [id])
  User                    User                      @relation(fields: [userId], references: [id])
  Message                 Message[]
  MessageReadReceipt      MessageReadReceipt[]
  MessagingReadPreference MessagingReadPreference[]
  RoleGrant               RoleGrant?
  PushSubscription        PushSubscription[]
  MessageStar             MessageStar[]
  ConversationPreference  ConversationPreference[]
  AssignedConversations   Conversation[]            @relation("ConversationAssignee")

  @@unique([userId, businessId])
  /// ADR-DAT-020 (Fase 2 PR 4, module 4c): references carry the business.
  @@unique([businessId, id])
  @@index([businessId, userId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Message {
  id                 String               @id @default(uuid())
  conversationId     String
  businessId         String
  authorUserId       String?
  authorCustomerId   String?
  sequence           BigInt
  clientMessageId    String
  type               MessagingMessageType
  content            String?
  createdAt          DateTime             @default(now())
  deliveredAt        DateTime?
  readAt             DateTime?
  editedAt           DateTime?
  deletedAt          DateTime?
  deletedByUserId    String?
  replyToMessageId   String?
  /// E4: sent with «Reenviar» from another chat (the bubble says «Reenviado»).
  forwarded          Boolean              @default(false)
  /// E6b: the greeting or the away message the store sends by itself («Mensaje automático»).
  automatic          Boolean              @default(false)
  Attachment         Attachment[]
  Cliente            Cliente?             @relation(fields: [authorCustomerId, businessId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  Membership         Membership?          @relation(fields: [authorUserId, businessId], references: [userId, businessId], onDelete: Restrict, onUpdate: Restrict)
  Conversation       Conversation         @relation(fields: [conversationId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: Restrict)
  MessageReadReceipt MessageReadReceipt[]
  Reaction           Reaction[]
  MessageStar        MessageStar[]

  @@unique([conversationId, clientMessageId, authorCustomerId])
  @@unique([conversationId, clientMessageId, authorUserId])
  @@unique([conversationId, sequence])
  @@unique([id, businessId])
  @@index([businessId, conversationId, createdAt])
  @@index([conversationId, deletedAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model MessageReadReceipt {
  id         String      @id @default(uuid())
  messageId  String
  businessId String
  userId     String?
  customerId String?
  readAt     DateTime    @default(now())
  Empresa    Empresa     @relation(fields: [businessId], references: [id])
  Cliente    Cliente?    @relation(fields: [customerId, businessId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  Message    Message     @relation(fields: [messageId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: Restrict)
  Membership Membership? @relation(fields: [userId, businessId], references: [userId, businessId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([messageId, customerId])
  @@unique([messageId, userId])
  @@index([businessId, customerId])
  @@index([businessId, messageId])
  @@index([businessId, userId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model MessagingReadPreference {
  id         String      @id @default(uuid())
  businessId String
  userId     String?
  customerId String?
  enabled    Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  Empresa    Empresa     @relation(fields: [businessId], references: [id])
  Cliente    Cliente?    @relation(fields: [customerId, businessId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  Membership Membership? @relation(fields: [userId, businessId], references: [userId, businessId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([customerId, businessId])
  @@unique([userId, businessId])
  @@index([businessId, customerId])
  @@index([businessId, userId])
}

model MovimientoCaja {
  id             String        @id @default(uuid())
  empresaId      String
  cajaId         String
  aperturaCajaId String?
  usuarioId      String
  tipo           String
  monto          Decimal       @db.Decimal(18, 2)
  descripcion    String?
  referenciaId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  AperturaCaja   AperturaCaja? @relation(fields: [empresaId, aperturaCajaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Caja           Caja          @relation(fields: [empresaId, cajaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Usuario        Usuario       @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
}

model MovimientoStock {
  id                   String           @id @default(uuid())
  empresaId            String
  productoId           String
  loteId               String?
  tipoMovimiento       String
  cantidad             Decimal          @db.Decimal(18, 4)
  /// ADR-DAT-009: the unit cost of this movement, so the stock is valued at weighted average cost.
  costoUnitario        Decimal?         @db.Decimal(18, 4)
  motivo               String
  referenciaId         String?
  usuarioId            String?
  recepcionCompraId    String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  loteVencidoAlMomento Boolean          @default(false)
  Empresa              Empresa          @relation(fields: [empresaId], references: [id])
  Lote                 Lote?            @relation(fields: [empresaId, loteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Producto             Producto         @relation(fields: [empresaId, productoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  RecepcionCompra      RecepcionCompra? @relation(fields: [empresaId, recepcionCompraId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Usuario              Usuario?         @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
}

model Notificacion {
  id           String   @id @default(uuid())
  empresaId    String
  pedidoId     String?
  evento       String
  canal        String
  destinatario String
  estadoEnvio  String
  mensaje      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Empresa      Empresa  @relation(fields: [empresaId], references: [id])
  Pedido       Pedido?  @relation(fields: [empresaId, pedidoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
}

model Pago {
  id              String           @id @default(uuid())
  empresaId       String
  usuarioId       String?
  ventaId         String?
  deudaId         String?
  monto           Decimal          @db.Decimal(18, 2)
  medio           String
  estado          EstadoPago       @default(PENDIENTE)
  comision        Decimal          @default(0) @db.Decimal(18, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  pedidoId        String?
  montoRecibido   Decimal?         @db.Decimal(18, 2)
  vuelto          Decimal?         @db.Decimal(18, 2)
  referencia      String?
  AplicacionPago  AplicacionPago[]
  CuentaCorriente CuentaCorriente? @relation(fields: [empresaId, deudaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Empresa         Empresa          @relation(fields: [empresaId], references: [id])
  Pedido          Pedido?          @relation(fields: [empresaId, pedidoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Usuario         Usuario?         @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Venta           Venta?           @relation(fields: [empresaId, ventaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  /// ADR-DAT-020 (Fase 2 PR 4, module 4a): lets references carry the business.
  @@unique([empresaId, id])
}

model PagoProveedor {
  id          String    @id @default(uuid())
  empresaId   String
  compraId    String
  proveedorId String
  usuarioId   String
  monto       Decimal   @db.Decimal(18, 2)
  medioPago   String
  referencia  String?
  fecha       DateTime  @default(now())
  notas       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Compra      Compra    @relation(fields: [empresaId, compraId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Empresa     Empresa   @relation(fields: [empresaId], references: [id])
  Proveedor   Proveedor @relation(fields: [empresaId, proveedorId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Usuario     Usuario   @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
}

model Pedido {
  id             String         @id @default(uuid())
  empresaId      String
  clienteId      String
  usuarioId      String?
  estado         EstadoPedido   @default(RECIBIDO)
  canalOrigen    String
  total          Decimal        @db.Decimal(18, 2)
  descuento      Decimal        @default(0) @db.Decimal(18, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  idempotencyKey String?
  /// OR-B4-053: N° per business (1, 2, 3…). The database assigns it on insert (trigger
  /// «Pedido_numerar»); never set it by hand.
  numero         Int?
  Entrega        Entrega?
  Notificacion   Notificacion[]
  Pago           Pago[]
  Cliente        Cliente        @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  Empresa        Empresa        @relation(fields: [empresaId], references: [id])
  Usuario        Usuario?       @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  PedidoItem     PedidoItem[]

  @@unique([empresaId, id])
  @@unique([empresaId, numero])
}

model PedidoItem {
  id                              String             @id @default(uuid())
  empresaId                       String
  pedidoId                        String
  productoId                      String
  cantidad                        Decimal            @db.Decimal(18, 4)
  precioUnitario                  Decimal            @db.Decimal(18, 2)
  descuentoItem                   Decimal            @default(0) @db.Decimal(18, 2)
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt
  descuentoFidelizacionPorcentaje Decimal?           @db.Decimal(5, 2)
  reglaFidelizacionId             String?
  /// OR-B4-046 §4.4 (stage C3): the offer that set this line's price, if any.
  ofertaId                        String?
  /// OR-B4-051 (stage C4): which discount won (D5: they never add up); null on older lines.
  origenPrecio                    OrigenPrecio?
  Oferta                          Oferta?            @relation(fields: [empresaId, ofertaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Pedido                          Pedido             @relation(fields: [empresaId, pedidoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Producto                        Producto           @relation(fields: [empresaId, productoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  ReglaFidelizacion               ReglaFidelizacion? @relation(fields: [empresaId, reglaFidelizacionId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
}

model Permiso {
  id             String           @id @default(uuid())
  nombre         String           @unique
  descripcion    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  UsuarioPermiso UsuarioPermiso[]
}

model Presentacion {
  id               String   @id @default(uuid())
  empresaId        String
  productoId       String
  nombre           String
  factorConversion Decimal  @db.Decimal(18, 4)
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  Empresa          Empresa  @relation(fields: [empresaId], references: [id])
  Producto         Producto @relation(fields: [empresaId, productoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([productoId, nombre])
}

model Producto {
  id                      String                    @id @default(uuid())
  empresaId               String
  nombre                  String
  codigoInterno           String
  codigoBarras            String?
  marca                   String?
  unidadBase              UnidadBase
  costo                   Decimal                   @db.Decimal(18, 4)
  precioMinorista         Decimal                   @db.Decimal(18, 2)
  precioMayorista         Decimal?                  @db.Decimal(18, 2)
  /// ADR-DAT-009 (OR-B4-046, stage C1): moving weighted average of what entered with a cost (purchases,
  /// opening stock). Null until the first such entry; `costo` is the last cost.
  costoPromedio           Decimal?                  @db.Decimal(18, 4)
  /// D10: the price that keeps the product's markup after a new cost. A person applies or dismisses
  /// it; the price never changes on its own. Null when there is nothing to review.
  precioSugerido          Decimal?                  @db.Decimal(18, 2)
  activo                  Boolean                   @default(true)
  /// OR-B4-046: the Catálogo is what the Business publishes in its store; the panel (Mercadería) sees 100 %.
  publicado               Boolean                   @default(false)
  /// Featured products go first in the store. Only a published product can be featured.
  destacado               Boolean                   @default(false)
  /// What the customer reads on the product page (OR-B4-046 rule 12).
  descripcion             String?
  /// OR-B4-046 rule 9 (D9): lots with an expiry date only for products that control expiry (they
  /// leave FEFO); the rest enter without a date and leave in arrival order (FIFO).
  controlaVencimiento     Boolean                   @default(false)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  stockMinimo             Decimal                   @default(0) @db.Decimal(18, 4)
  descuentoPorcentaje     Decimal?                  @db.Decimal(5, 2)
  familiaId               String
  subfamiliaId            String
  tipoId                  String
  subtipoId               String
  CartItem                CartItem[]
  CompraItem              CompraItem[]
  DevolucionClienteItem   DevolucionClienteItem[]
  DevolucionProveedorItem DevolucionProveedorItem[]
  Lote                    Lote[]
  MovimientoStock         MovimientoStock[]
  PedidoItem              PedidoItem[]
  Presentacion            Presentacion[]
  Empresa                 Empresa                   @relation(fields: [empresaId], references: [id])
  Familia                 Familia                   @relation(fields: [empresaId, familiaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Subfamilia              Subfamilia                @relation(fields: [empresaId, subfamiliaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Subtipo                 Subtipo                   @relation(fields: [empresaId, subtipoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Tipo                    Tipo                      @relation(fields: [empresaId, tipoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  ProductoProveedor       ProductoProveedor[]
  VentaItem               VentaItem[]
  ProductoFoto            ProductoFoto[]
  OfertaProducto          OfertaProducto[]

  @@unique([empresaId, codigoInterno])
  @@unique([empresaId, id])
}

/// OR-B4-046 §4.4 (D4, stage C3): a special price between two dates, which the customer sees as
/// «Oferta». A percent off, or an offer price, for some products or (percent only) a whole category.
/// It rules in the store, at the counter and in the chat, or only in the store. An offer is never
/// deleted: it ends (`hasta`), and the lines it priced keep pointing at it.
model Oferta {
  id                  String           @id @default(uuid())
  empresaId           String
  nombre              String
  tipo                TipoOferta
  /// PORCENTAJE: the percent off the list price.
  descuentoPorcentaje Decimal?         @db.Decimal(5, 2)
  /// PRECIO: the price each product of the offer is sold at.
  precioOferta        Decimal?         @db.Decimal(18, 2)
  desde               DateTime
  hasta               DateTime
  soloTienda          Boolean          @default(false)
  /// Ended (or cancelled before starting) by a person; the dates stay as they were set.
  terminadaEn         DateTime?
  /// A whole category (PORCENTAJE only); otherwise its products are in OfertaProducto.
  familiaId           String?
  usuarioId           String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  Empresa             Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  Familia             Familia?         @relation(fields: [empresaId, familiaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  OfertaProducto      OfertaProducto[]
  PedidoItem          PedidoItem[]
  VentaItem           VentaItem[]

  @@unique([empresaId, id])
  @@index([empresaId, hasta])
}

/// The products of an offer that is not by category.
model OfertaProducto {
  id         String   @id @default(uuid())
  empresaId  String
  ofertaId   String
  productoId String
  createdAt  DateTime @default(now())
  Empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  Oferta     Oferta   @relation(fields: [empresaId, ofertaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Producto   Producto @relation(fields: [empresaId, productoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([ofertaId, productoId])
  @@index([productoId])
}

/// OR-B4-046 rule 12: up to 5 photos per product, for the store. The file lives on the server's
/// volume, outside any web root (like chat files, OR-B4-037); this row says which file and in what
/// order. The first one (lowest orden) is the photo of the product in the store's list.
model ProductoFoto {
  id         String   @id @default(uuid())
  empresaId  String
  productoId String
  orden      Int
  storageKey String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())
  Empresa    Empresa  @relation(fields: [empresaId], references: [id])
  Producto   Producto @relation(fields: [empresaId, productoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([empresaId, productoId, orden])
}

model ProductoProveedor {
  id              String    @id @default(uuid())
  empresaId       String
  productoId      String
  proveedorId     String
  /// OR-B4-052 (stage D1): the supplier's own code for the product.
  codigoProveedor String?
  /// The last unit cost the supplier charged (updated by each reception).
  costoUnitario   Decimal?  @db.Decimal(18, 4)
  ultimaCompra    DateTime?
  /// The usual supplier of the product (at most one per product); the purchase suggestion groups by it.
  habitual        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  Empresa         Empresa   @relation(fields: [empresaId], references: [id])
  Producto        Producto  @relation(fields: [empresaId, productoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Proveedor       Proveedor @relation(fields: [empresaId, proveedorId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([productoId, proveedorId])
}

model Proveedor {
  id                  String                @id @default(uuid())
  empresaId           String
  nombre              String
  email               String?
  telefono            String?
  direccion           String?
  /// OR-B4-052 (stage D1): the supplier's tax and commercial data.
  cuit                String?
  condicionIva        CondicionIva?
  /// Days to pay: 0 is cash, 30 is «30 días».
  plazoPagoDias       Int?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  Compra              Compra[]
  DevolucionProveedor DevolucionProveedor[]
  PagoProveedor       PagoProveedor[]
  ProductoProveedor   ProductoProveedor[]
  Empresa             Empresa               @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, nombre])
  @@unique([empresaId, id])
}

/// E4 — one reaction per person and message (choosing another replaces it, like WhatsApp), from a
/// team member OR a customer, never both (check constraint Reaction_one_owner).
model Reaction {
  id         String   @id @default(uuid())
  messageId  String
  businessId String
  userId     String?
  customerId String?
  emoji      String
  createdAt  DateTime @default(now())
  Message    Message  @relation(fields: [messageId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: Restrict)
  User       User?    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  Cliente    Cliente? @relation(fields: [customerId, businessId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([messageId, userId])
  @@unique([messageId, customerId])
  @@index([userId, messageId])
  @@index([businessId, messageId])
}

/// E4 — a message a team member starred (⭐): personal, only they see it in «Destacados».
model MessageStar {
  id         String     @id @default(uuid())
  messageId  String
  businessId String
  userId     String
  createdAt  DateTime   @default(now())
  Message    Message    @relation(fields: [messageId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: Restrict)
  Membership Membership @relation(fields: [userId, businessId], references: [userId, businessId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([messageId, userId])
  @@index([businessId, userId, createdAt])
}

model RecepcionCompra {
  id              String            @id @default(uuid())
  empresaId       String
  compraId        String
  usuarioId       String
  fechaRecepcion  DateTime          @default(now())
  observaciones   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  MovimientoStock MovimientoStock[]
  Compra          Compra            @relation(fields: [empresaId, compraId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Empresa         Empresa           @relation(fields: [empresaId], references: [id])
  Usuario         Usuario           @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([empresaId, id])
}

model ReglaFidelizacion {
  id                  String         @id @default(uuid())
  empresaId           String
  nombre              String
  nivelRequerido      NivelFidelidad
  descuentoPorcentaje Decimal        @db.Decimal(5, 2)
  marca               String?
  cantidadMinima      Int?
  activo              Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  familiaId           String?
  subfamiliaId        String?
  tipoId              String?
  subtipoId           String?
  PedidoItem          PedidoItem[]
  Empresa             Empresa        @relation(fields: [empresaId], references: [id])
  Familia             Familia?       @relation(fields: [empresaId, familiaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Subfamilia          Subfamilia?    @relation(fields: [empresaId, subfamiliaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Subtipo             Subtipo?       @relation(fields: [empresaId, subtipoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Tipo                Tipo?          @relation(fields: [empresaId, tipoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  VentaItem           VentaItem[]

  @@unique([empresaId, id])
}

model RoleCapability {
  id                   String               @id @default(uuid())
  roleTemplateId       String
  capabilityDefId      String
  createdAt            DateTime             @default(now())
  CapabilityDefinition CapabilityDefinition @relation(fields: [capabilityDefId], references: [id])
  RoleTemplate         RoleTemplate         @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)

  @@unique([roleTemplateId, capabilityDefId])
  @@index([roleTemplateId])
}

model RoleGrant {
  id              String            @id @default(uuid())
  businessId      String
  membershipId    String            @unique
  roleTemplateId  String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  CapabilityGrant CapabilityGrant[]
  Membership      Membership        @relation(fields: [businessId, membershipId], references: [businessId, id], onDelete: Cascade, onUpdate: Restrict)
  RoleTemplate    RoleTemplate      @relation(fields: [roleTemplateId], references: [id])

  /// ADR-DAT-020 (Fase 2 PR 4, module 4c): references carry the business.
  @@unique([businessId, id])
  @@unique([businessId, membershipId])
  @@index([membershipId])
}

model RoleTemplate {
  id             String           @id @default(uuid())
  name           String           @unique
  description    String?
  empresaId      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  RoleCapability RoleCapability[]
  RoleGrant      RoleGrant[]
}

model Subfamilia {
  id                String              @id @default(uuid())
  empresaId         String
  familiaId         String
  nombre            String
  prefijo           String              @db.Char(3)
  activo            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Producto          Producto[]
  ReglaFidelizacion ReglaFidelizacion[]
  Empresa           Empresa             @relation(fields: [empresaId], references: [id])
  Familia           Familia             @relation(fields: [empresaId, familiaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Tipo              Tipo[]

  @@unique([familiaId, nombre])
  @@unique([familiaId, prefijo])
  /// ADR-DAT-020 (Fase 2 PR 4, module 3): lets references carry the business.
  @@unique([empresaId, id])
}

model Subtipo {
  id                String              @id @default(uuid())
  empresaId         String
  tipoId            String
  nombre            String
  prefijo           String              @db.Char(3)
  activo            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Producto          Producto[]
  ReglaFidelizacion ReglaFidelizacion[]
  Empresa           Empresa             @relation(fields: [empresaId], references: [id])
  Tipo              Tipo                @relation(fields: [empresaId, tipoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tipoId, nombre])
  @@unique([tipoId, prefijo])
  /// ADR-DAT-020 (Fase 2 PR 4, module 3): lets references carry the business.
  @@unique([empresaId, id])
}

model Tipo {
  id                String              @id @default(uuid())
  empresaId         String
  subfamiliaId      String
  nombre            String
  prefijo           String              @db.Char(3)
  activo            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Producto          Producto[]
  ReglaFidelizacion ReglaFidelizacion[]
  Subtipo           Subtipo[]
  Empresa           Empresa             @relation(fields: [empresaId], references: [id])
  Subfamilia        Subfamilia          @relation(fields: [empresaId, subfamiliaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([subfamiliaId, nombre])
  @@unique([subfamiliaId, prefijo])
  /// ADR-DAT-020 (Fase 2 PR 4, module 3): lets references carry the business.
  @@unique([empresaId, id])
}

/// OR-B4-015 / R8-INV-003 (#166): where the stock is. Every business has one main location
/// («Principal», created with the business by a database trigger; one per business by the partial
/// unique index "Ubicacion_una_principal_por_negocio"), and every lot is in a location. More
/// locations and transfers between them come later (TO-BE §4.6).
/// Deleting a whole business deletes its locations (OR-B4-050, the only exception to ADR-DAT-020
/// D3); a location that still holds lots cannot be deleted.
model Ubicacion {
  id        String   @id @default(uuid())
  empresaId String
  nombre    String
  principal Boolean  @default(false)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  Lote      Lote[]

  @@unique([empresaId, id])
  @@unique([empresaId, nombre])
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  nombre       String
  passwordHash String?
  googleId     String?      @unique
  fotoUrl      String?
  usuarioId    String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  Membership   Membership[]
  Reaction     Reaction[]
}

model Usuario {
  id                                               String                   @id @default(uuid())
  empresaId                                        String
  nombre                                           String
  email                                            String                   @unique
  passwordHash                                     String?
  activo                                           Boolean                  @default(true)
  createdAt                                        DateTime                 @default(now())
  updatedAt                                        DateTime                 @updatedAt
  fotoUrl                                          String?
  googleId                                         String?                  @unique
  estadoLegajo                                     EstadoLegajo             @default(APROBADO)
  rol                                              RolUsuario               @default(OWNER)
  AperturaCaja                                     AperturaCaja[]
  ArqueoCaja_ArqueoCaja_usuarioEntranteIdToUsuario ArqueoCaja[]             @relation("ArqueoCaja_usuarioEntranteIdToUsuario")
  ArqueoCaja_ArqueoCaja_usuarioIdToUsuario         ArqueoCaja[]             @relation("ArqueoCaja_usuarioIdToUsuario")
  AuditLog                                         AuditLog[]
  Autorizacion                                     Autorizacion[]
  CierreCaja                                       CierreCaja[]
  Compra                                           Compra[]
  DevolucionCliente                                DevolucionCliente[]      @relation("DevolucionCliente_creadoPorIdToUsuario")
  DevolucionProveedor                              DevolucionProveedor[]
  Entrega_Entrega_preparadorIdToUsuario            Entrega[]                @relation("Entrega_preparadorIdToUsuario")
  Entrega_Entrega_repartidorIdToUsuario            Entrega[]                @relation("Entrega_repartidorIdToUsuario")
  MfaFactor                                        MfaFactor?
  Invitacion                                       Invitacion[]
  Legajo                                           Legajo?
  MovimientoCaja                                   MovimientoCaja[]
  MovimientoStock                                  MovimientoStock[]
  Pago                                             Pago[]
  PagoProveedor                                    PagoProveedor[]
  Pedido                                           Pedido[]
  RecepcionCompra                                  RecepcionCompra[]
  Empresa                                          Empresa                  @relation(fields: [empresaId], references: [id])
  UserEmpresa                                      UserEmpresa[]
  UsuarioPermiso                                   UsuarioPermiso[]
  PasswordResetToken                               PasswordResetToken[]
  Venta                                            Venta[]
  PhoneNumber                                      PhoneNumber[]
  SMSAlert                                         SMSAlert[]
  NotificationPreference                           NotificationPreference[]
  NotificationDigest                               NotificationDigest[]
  EmailPreference                                  EmailPreference?         @relation("EmailPreference_usuario")

  @@unique([empresaId, id])
}

/// Notification Preferences - User notification settings and delivery preferences
model NotificationPreference {
  id        String @id @default(uuid())
  usuarioId String
  empresaId String

  /// Channel settings
  pushEnabled  Boolean @default(true)
  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)

  /// Frequency settings (per notification type)
  orderNotifications     NotificationFrequency @default(REAL_TIME)
  messageNotifications   NotificationFrequency @default(REAL_TIME)
  inventoryNotifications NotificationFrequency @default(DAILY)
  systemNotifications    NotificationFrequency @default(REAL_TIME)

  /// Quiet hours (24-hour format HH:MM)
  quietHoursEnabled Boolean @default(false)
  quietHoursStart   String? /// "22:00"
  quietHoursEnd     String? /// "08:00"

  /// Digest settings
  digestFrequency DigestPeriod @default(DAILY)
  digestTime      String       @default("09:00") /// preferred send time HH:MM

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Usuario Usuario @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([usuarioId, empresaId])
  @@index([empresaId, usuarioId])
}

/// Notification Digest - Batched notifications sent at scheduled intervals
model NotificationDigest {
  id        String       @id @default(uuid())
  usuarioId String
  empresaId String
  period    DigestPeriod
  startDate DateTime
  endDate   DateTime
  summary   Json /// { orders: 5, messages: 12, inventory: 3 }
  content   String /// HTML digest content
  sentAt    DateTime?
  openedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Usuario Usuario @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId, usuarioId, period])
  @@index([usuarioId, sentAt])
}

model UserEmpresa {
  id        String   @id @default(uuid())
  usuarioId String
  empresaId String
  role      String   @default("owner") // owner, admin, user, editor
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Usuario Usuario @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId])
  @@index([usuarioId])
  @@index([empresaId])
}

/// Single-use password recovery link for a staff Usuario (Figma "Recuperar contraseña").
/// Only the SHA-256 of the token is stored; the raw token travels in the email link.
model PasswordResetToken {
  id        String    @id @default(uuid())
  usuarioId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  Usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, createdAt])
}

model UsuarioPermiso {
  id        String   @id @default(uuid())
  empresaId String
  usuarioId String
  permisoId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Permiso   Permiso  @relation(fields: [permisoId], references: [id])
  Usuario   Usuario  @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([usuarioId, permisoId])
}

model Venta {
  id                 String              @id @default(uuid())
  empresaId          String
  usuarioId          String
  clienteId          String?
  canal              String
  total              Decimal             @db.Decimal(18, 2)
  descuento          Decimal             @default(0) @db.Decimal(18, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  estado             EstadoVenta         @default(CONFIRMADA)
  idempotencyKey     String?             @unique
  /// OR-B4-051 (stage C4): the payment method whose discount priced this sale; it must be paid with it.
  medioPagoDescuento String?
  numero             Int?
  AuditLog           AuditLog[]
  Deuda              Deuda[]
  DevolucionCliente  DevolucionCliente[]
  Pago               Pago[]
  Payment            Payment[]
  Cliente            Cliente?            @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  Empresa            Empresa             @relation(fields: [empresaId], references: [id])
  Usuario            Usuario             @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  VentaItem          VentaItem[]

  @@unique([empresaId, id])
  @@index([empresaId, numero])
}

model VentaItem {
  id                              String                  @id @default(uuid())
  empresaId                       String
  ventaId                         String
  productoId                      String
  cantidad                        Decimal                 @db.Decimal(18, 4)
  precioUnitario                  Decimal                 @db.Decimal(18, 2)
  descuentoItem                   Decimal                 @default(0) @db.Decimal(18, 2)
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt
  descuentoFidelizacionPorcentaje Decimal?                @db.Decimal(5, 2)
  reglaFidelizacionId             String?
  /// OR-B4-046 §4.4 (stage C3): the offer that set this line's price, if any.
  ofertaId                        String?
  /// OR-B4-051 (stage C4): which discount won (D5: they never add up); null on older lines.
  origenPrecio                    OrigenPrecio?
  Oferta                          Oferta?                 @relation(fields: [empresaId, ofertaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  DevolucionClienteItem           DevolucionClienteItem[]
  Producto                        Producto                @relation(fields: [empresaId, productoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  ReglaFidelizacion               ReglaFidelizacion?      @relation(fields: [empresaId, reglaFidelizacionId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Venta                           Venta                   @relation(fields: [empresaId, ventaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([empresaId, id])
}

enum CapabilityGrantType {
  GRANT
  DENY
}

enum EstadoDevolucion {
  SOLICITADA
  AUTORIZADA
  RECIBIDA
  PROCESADA
}

enum EstadoReembolso {
  PENDIENTE
  EN_PROCESO
  EXITO
  FALLIDO
  RECHAZADO
  PENDIENTE_MANUAL
}

enum EstadoCaja {
  CERRADA
  ABIERTA
  EN_ARQUEO
}

enum EstadoCompra {
  BORRADOR
  EMITIDA
  RECEPCION_PARCIAL
  RECIBIDA
}

enum EstadoLegajo {
  PENDIENTE
  APROBADO
}

enum EstadoPago {
  PENDIENTE
  EN_PROCESO
  APROBADO
  RECHAZADO
  CANCELADO
  REEMBOLSADO_PARCIAL
  REEMBOLSADO_TOTAL
}

enum EstadoPedido {
  RECIBIDO
  CONFIRMADO
  EN_PREPARACION
  LISTO
  ASIGNADO
  EN_CAMINO
  ENTREGADO
  PARCIALMENTE_ENTREGADO
  ENTREGA_FALLIDA
  CANCELADO
}

enum EstadoVenta {
  CONFIRMADA
  ANULADA
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum MessagingAssociationType {
  CUSTOMER
  ORDER
  SALE
  PRODUCT
  PURCHASE
}

enum MessagingConversationType {
  DIRECT
  GROUP
}

enum MessagingMessageType {
  TEXT
  IMAGE
  FILE
  VOICE
  /// Paquete 1 S3: posted by the system for the Business (order and return notices).
  SYSTEM
}

enum NivelFidelidad {
  NUEVO
  FRECUENTE
  VIP
}

// Canonical Membership Roles: OWNER, ADMIN, VENDEDOR, GESTOR_DE_STOCK (AUTH-01, OR-B4-027).
// ASISTENTE_LOCAL is a transitional alias of VENDEDOR until 2026-12-31; PROVEEDOR and
// REPARTIDOR are not Membership Roles (OR-B4-006). Removing values needs an Owner decision.
enum RolUsuario {
  OWNER
  ASISTENTE_LOCAL
  PROVEEDOR
  REPARTIDOR
  ADMIN
  VENDEDOR
  GESTOR_DE_STOCK
}

enum TipoDocumentoLegajo {
  ANTECEDENTES_PENALES
  CONSTANCIA_CUIL
}

enum NotificationFrequency {
  REAL_TIME
  DAILY
  WEEKLY
  OFF
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
}

enum NotificationType {
  ORDER
  MESSAGE
  INVENTORY
  SYSTEM
}

enum DigestPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

/// OR-B4-052: the supplier's VAT condition (Argentina).
enum CondicionIva {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
}

/// OR-B4-051 (D5): where a line's price came from. The lowest candidate wins; only one applies.
enum OrigenPrecio {
  LISTA
  DESCUENTO_PRODUCTO
  OFERTA
  MAYORISTA
  MEDIO_PAGO
  FIDELIZACION
}

/// OR-B4-046 §4.4: a percent off, or a fixed offer price.
enum TipoOferta {
  PORCENTAJE
  PRECIO
}

enum UnidadBase {
  UNIDAD
  KILOGRAMO
  LITRO
  METRO
  PACK
  CAJA
}

enum SMSType {
  OTP
  ALERT
  TRANSACTIONAL
  BULK
}

enum SMSStatus {
  SENT
  DELIVERED
  FAILED
  PENDING
}

enum OTPPurpose {
  LOGIN
  PAYMENT
  ACCOUNT_VERIFICATION
  PASSWORD_RESET
}

model PhoneNumber {
  id                      String    @id @default(uuid())
  usuarioId               String?
  clienteId               String?
  empresaId               String
  phoneNumber             String
  countryCode             String    @default("+54") // Argentina by default
  isVerified              Boolean   @default(false)
  isPrimary               Boolean   @default(false)
  verificationCode        String?
  verificationCodeExpires DateTime?
  lastUsedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  Usuario     Usuario?     @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Cliente     Cliente?     @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  Empresa     Empresa      @relation(fields: [empresaId], references: [id])
  smsLogs     SMSLog[]
  otpSessions OTPSession[]
  smsAlerts   SMSAlert[]

  @@unique([empresaId, phoneNumber])
  /// ADR-DAT-020 (Fase 2 PR 4, module 4c): references carry the business.
  @@unique([empresaId, id])
  @@index([usuarioId])
  @@index([clienteId])
  @@index([empresaId])
}

model OTPSession {
  id            String     @id @default(uuid())
  empresaId     String
  phoneNumberId String
  purpose       OTPPurpose
  code          String
  attempts      Int        @default(0)
  maxAttempts   Int        @default(3)
  expiresAt     DateTime
  verifiedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  phoneNumber PhoneNumber @relation(fields: [empresaId, phoneNumberId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([phoneNumberId])
  @@index([expiresAt])
}

model SMSLog {
  id            String    @id @default(uuid())
  empresaId     String
  phoneNumberId String
  toPhone       String    @db.VarChar(20)
  message       String    @db.VarChar(160)
  type          SMSType
  status        SMSStatus @default(PENDING)
  twilioSid     String?   @unique
  errorCode     String?
  errorMessage  String?
  sentAt        DateTime  @default(now())
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  phoneNumber PhoneNumber @relation(fields: [empresaId, phoneNumberId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([phoneNumberId])
  @@index([status])
  @@index([createdAt])
  @@index([twilioSid])
}

model SMSAlert {
  id            String   @id @default(uuid())
  empresaId     String
  usuarioId     String?
  clienteId     String?
  trigger       String // "order_confirmation", "inventory_low", "payment_received", etc
  message       String
  isActive      Boolean  @default(true)
  phoneNumberId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  Empresa     Empresa      @relation(fields: [empresaId], references: [id])
  Usuario     Usuario?     @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Cliente     Cliente?     @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  PhoneNumber PhoneNumber? @relation(fields: [empresaId, phoneNumberId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([empresaId])
  @@index([usuarioId])
  @@index([clienteId])
}

// P8-2: Email Notifications models
model EmailTemplate {
  id            String    @id @default(uuid())
  empresaId     String
  nombre        String
  tipo          TipoEmail @default(TRANSACCIONAL)
  asunto        String
  contenidoHtml String // Handlebars template: {{variable}}
  variables     Json? // Schema: {"required": ["userId"], "optional": ["orderId"]}
  activo        Boolean   @default(true)
  versionActual Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  Empresa       Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  EmailLog      EmailLog[]
  EmailCampaign EmailCampaign[]

  @@unique([empresaId, nombre, versionActual])
  /// ADR-DAT-020 (Fase 2 PR 4, module 4c): references carry the business.
  @@unique([empresaId, id])
  @@index([empresaId, tipo, activo])
}

model EmailLog {
  id                String    @id @default(uuid())
  empresaId         String
  templateId        String?
  destinatario      String
  asunto            String
  contenido         String? // Rendered HTML
  evento            String    @default("ENVIADO") // ENVIADO, ABIERTO, CLICK, REBOTE, QUEJA
  proveedor         String    @default("RESEND") // RESEND, SENDGRID, SES
  providerMessageId String?   @unique // Provider's message ID for tracking
  metadata          Json? // tracking: {openedAt, clicks: [{url, clickedAt}]}
  idReferencia      String? // orderId, ventaId, etc
  tipoReferencia    String? // "Venta", "Pedido", "Invitacion"
  intentos          Int       @default(1)
  errorMensaje      String?
  proxRetento       DateTime? // Null = no retry needed
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  Empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  EmailTemplate EmailTemplate? @relation(fields: [empresaId, templateId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([empresaId, destinatario, createdAt])
  @@index([empresaId, tipoReferencia, idReferencia])
  @@index([proveedor, providerMessageId])
  @@index([proxRetento]) // For retry queries
}

model EmailPreference {
  id                  String    @id @default(uuid())
  empresaId           String
  usuarioId           String?   @unique
  clienteId           String?   @unique // For non-staff customers
  email               String
  categoriasOptIn     Json? // {"transaccional": true, "marketing": true, "newsletters": false}
  frecuencia          String    @default("TODAS") // TODAS, SEMANAL, MENSUAL, NUNCA
  suscrito            Boolean   @default(true)
  desuscritaEn        DateTime?
  motivoDesuscripcion String?
  unsubscribeToken    String    @unique @db.VarChar(128) // For anonymous unsubscribe links
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  Empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  Usuario Usuario? @relation("EmailPreference_usuario", fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Cliente Cliente? @relation("EmailPreference_cliente", fields: [clienteId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([empresaId, email])
  /// ADR-DAT-020 (Fase 2 PR 4, module 4c): references carry the business.
  @@unique([empresaId, usuarioId])
  @@unique([clienteId, empresaId])
  @@index([empresaId, suscrito])
  @@index([empresaId, desuscritaEn])
}

model EmailCampaign {
  id                    String         @id @default(uuid())
  empresaId             String
  templateId            String
  nombre                String
  descripcion           String?
  estadio               EstadoCampaign @default(BORRADOR)
  audiencia             String         @default("CLIENTES") // CLIENTES, USUARIOS, SUSCRIPTORES, MANUAL
  filtroAudiencia       Json? // {status: "ACTIVO", createdAfter: "2024-01-01"}
  programadaPara        DateTime?
  iniciadaEn            DateTime?
  finalizadaEn          DateTime?
  destinatariosTotal    Int?
  destinatariosEnviados Int            @default(0)
  destinatariosFallidos Int            @default(0)
  tasaApertura          Decimal?       @db.Decimal(5, 2)
  tasaClick             Decimal?       @db.Decimal(5, 2)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  Empresa       Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  EmailTemplate EmailTemplate @relation(fields: [empresaId, templateId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([empresaId, estadio])
  @@index([empresaId, programadaPara])
  @@index([empresaId, iniciadaEn])
}

// P8-2: Email enums
enum TipoEmail {
  TRANSACCIONAL // Order confirmations, password reset, invitations
  MARKETING // Promotions, newsletters
  ALERTAS // Stock alerts, payment reminders
}

enum EstadoCampaign {
  BORRADOR
  PROGRAMADA
  ENVIANDO
  COMPLETADA
  CANCELADA
}

// P11-1: Payment Gateway Models
model Payment {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  ventaId String
  venta   Venta  @relation(fields: [empresaId, ventaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  monto  Decimal @db.Decimal(18, 2)
  moneda String  @default("ARS")

  proveedor         String // "STRIPE" | "MERCADOPAGO"
  providerPaymentId String @unique

  estado String @default("PENDING") // "PENDING" | "COMPLETED" | "FAILED" | "CANCELLED"

  metodo         String? // "CARD" | "BANK_TRANSFER" | "QR" | "WALLET"
  ultimosDigitos String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  PaymentIntent PaymentIntent[]
  Refund        Refund[]

  /// ADR-DAT-020 (Fase 2 PR 4, module 4c): references carry the business.
  @@unique([empresaId, id])
  @@index([empresaId, estado])
  @@index([ventaId])
  @@index([empresaId, createdAt])
}

model PaymentIntent {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  paymentId String
  payment   Payment @relation(fields: [empresaId, paymentId], references: [empresaId, id], onDelete: Cascade, onUpdate: Restrict)

  clientSecret     String @unique
  providerIntentId String @unique

  metadata Json?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([empresaId, expiresAt])
  @@index([paymentId])
}

model PaymentWebhook {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  tipo            String // "payment.success" | "payment.failed" | "refund.completed" | etc
  providerEventId String @unique

  payload Json

  processed   Boolean   @default(false)
  processedAt DateTime?

  createdAt DateTime @default(now())

  @@index([empresaId, processed])
  @@index([empresaId, createdAt])
}

model Refund {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  paymentId String
  payment   Payment @relation(fields: [empresaId, paymentId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  monto Decimal @db.Decimal(18, 2)
  razon String // "CUSTOMER_REQUEST" | "MISTAKE" | "FRAUD_SUSPECTED" | "OTHER"

  estado           String  @default("PENDING") // "PENDING" | "COMPLETED" | "FAILED"
  providerRefundId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, estado])
  @@index([paymentId])
}

/// OR-B4-044 — second factor (TOTP app) of a staff account. One row per account that started
/// enrolling; `confirmedAt` null = not active yet. The secret is encrypted (MFA_SECRET_KEY,
/// AES-256-GCM); recovery codes are stored as SHA-256 hashes; `lastStep` stops a code from being
/// used twice; 5 failed attempts lock it for 15 minutes.
model MfaFactor {
  id             String    @id @default(uuid())
  usuarioId      String    @unique
  secretEnc      String
  confirmedAt    DateTime?
  recoveryHashes Json      @default("[]")
  lastStep       Int       @default(0)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  Usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

/// ADR-IDN-001/011 — universal buyer: one Wapsell account to buy in any business. Global
/// identity (no tenant field, like User). Each business keeps its own Cliente linked to it.
model Comprador {
  id                String           @id @default(uuid())
  email             String           @unique
  nombre            String
  passwordHash      String?
  googleId          String?          @unique
  fotoUrl           String?
  emailVerificadoAt DateTime?
  activo            Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  Clientes          Cliente[]
  Tokens            CompradorToken[]
}

/// Single-use links for a Comprador (email verification). Only the SHA-256 of the token is kept.
model CompradorToken {
  id          String    @id @default(uuid())
  compradorId String
  tokenHash   String    @unique
  tipo        String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  Comprador   Comprador @relation(fields: [compradorId], references: [id], onDelete: Cascade)

  @@index([compradorId, tipo])
}

/// E3 (messaging like WhatsApp) — a browser of a team member that accepted push notifications:
/// new messages reach it with Wapsell closed. One row per browser (endpoint); keys are the
/// browser's public ones (Web Push, RFC 8291), not secrets of Wapsell.
/// E3 / paquete 1 F1 — a browser that accepted push: of a team member OR of a customer
/// (CHECK «PushSubscription_one_owner»).
model PushSubscription {
  id         String      @id @default(uuid())
  businessId String
  userId     String?
  customerId String?
  endpoint   String
  p256dh     String
  auth       String
  createdAt  DateTime    @default(now())
  lastUsedAt DateTime?
  Membership Membership? @relation(fields: [userId, businessId], references: [userId, businessId], onDelete: Restrict, onUpdate: Restrict)
  Cliente    Cliente?    @relation(fields: [customerId, businessId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([businessId, endpoint])
  @@index([businessId, userId])
  @@index([businessId, customerId])
}
