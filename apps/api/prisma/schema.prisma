generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AperturaCaja {
  id             String           @id @default(uuid())
  empresaId      String
  cajaId         String
  usuarioId      String
  montoInicial   Decimal          @db.Decimal(18, 2)
  fechaApertura  DateTime         @default(now())
  fechaCierre    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  Caja           Caja             @relation(fields: [empresaId, cajaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Usuario        Usuario          @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  ArqueoCaja     ArqueoCaja[]
  CierreCaja     CierreCaja?
  MovimientoCaja MovimientoCaja[]

  /// ADR-DAT-020 (Fase 2 PR 4, module 4a): lets references carry the business.
  @@unique([empresaId, id])
}

model AplicacionPago {
  id            String   @id @default(uuid())
  empresaId     String
  pagoId        String
  deudaId       String
  montoAplicado Decimal  @db.Decimal(18, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  Deuda         Deuda    @relation(fields: [empresaId, deudaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Pago          Pago     @relation(fields: [empresaId, pagoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([pagoId, deudaId])
}

model ArqueoCaja {
  id                                            String        @id @default(uuid())
  empresaId                                     String
  cajaId                                        String
  aperturaCajaId                                String
  usuarioId                                     String
  fondoFijoContado                              Decimal       @db.Decimal(18, 2)
  efectivoVentasContado                         Decimal       @db.Decimal(18, 2)
  efectivoDeudasContado                         Decimal       @db.Decimal(18, 2)
  gastosRetirosRegistrados                      Decimal       @db.Decimal(18, 2)
  efectivoEsperado                              Decimal       @db.Decimal(18, 2)
  efectivoContado                               Decimal       @db.Decimal(18, 2)
  diferencia                                    Decimal       @db.Decimal(18, 2)
  autorizacionId                                String?
  fechaArqueo                                   DateTime      @default(now())
  createdAt                                     DateTime      @default(now())
  updatedAt                                     DateTime      @updatedAt
  usuarioEntranteId                             String
  AperturaCaja                                  AperturaCaja  @relation(fields: [empresaId, aperturaCajaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Autorizacion                                  Autorizacion? @relation(fields: [empresaId, autorizacionId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Caja                                          Caja          @relation(fields: [empresaId, cajaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Usuario_ArqueoCaja_usuarioEntranteIdToUsuario Usuario       @relation("ArqueoCaja_usuarioEntranteIdToUsuario", fields: [empresaId, usuarioEntranteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Usuario_ArqueoCaja_usuarioIdToUsuario         Usuario       @relation("ArqueoCaja_usuarioIdToUsuario", fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
}

model Attachment {
  id          String    @id @default(uuid())
  messageId   String
  businessId  String
  storageKey  String
  filename    String
  mimeType    String
  sizeBytes   BigInt
  durationSec Int?
  metadata    Json?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  Message     Message   @relation(fields: [messageId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: Restrict)

  @@index([messageId, deletedAt])
  @@index([storageKey])
}

model AuditLog {
  id                 String        @id @default(uuid())
  empresaId          String
  usuarioId          String?
  fechaHora          DateTime      @default(now())
  accion             String
  entidadAfectada    String
  entidadId          String?
  valoresAnteriores  Json?
  valoresPosteriores Json?
  motivo             String?
  autorizacionId     String?
  ventaId            String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  Autorizacion       Autorizacion? @relation(fields: [empresaId, autorizacionId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Empresa            Empresa       @relation(fields: [empresaId], references: [id])
  Usuario            Usuario?      @relation(fields: [usuarioId], references: [id])
  Venta              Venta?        @relation(fields: [empresaId, ventaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
}

model Autorizacion {
  id                String       @id @default(uuid())
  empresaId         String
  autorizadorId     String
  operacion         String
  entidadAfectada   String?
  entidadId         String?
  motivo            String?
  fechaAutorizacion DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  ArqueoCaja        ArqueoCaja[]
  AuditLog          AuditLog[]
  Usuario           Usuario      @relation(fields: [empresaId, autorizadorId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Empresa           Empresa      @relation(fields: [empresaId], references: [id])

  /// ADR-DAT-020 (Fase 2 PR 4, module 4a): lets references carry the business.
  @@unique([empresaId, id])
}

model Caja {
  id             String           @id @default(uuid())
  empresaId      String           @unique
  nombre         String           @default("Caja Principal")
  fondoFijo      Decimal          @db.Decimal(18, 2)
  estado         EstadoCaja       @default(CERRADA)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  AperturaCaja   AperturaCaja[]
  ArqueoCaja     ArqueoCaja[]
  Empresa        Empresa          @relation(fields: [empresaId], references: [id])
  MovimientoCaja MovimientoCaja[]

  /// ADR-DAT-020 (Fase 2 PR 4, module 4a): lets references carry the business.
  @@unique([empresaId, id])
}

model CapabilityDefinition {
  id              String            @id @default(uuid())
  code            String            @unique
  description     String?
  category        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  CapabilityGrant CapabilityGrant[]
  RoleCapability  RoleCapability[]
}

model CapabilityGrant {
  id                   String               @id @default(uuid())
  businessId           String
  roleGrantId          String
  capabilityDefId      String
  grantType            String               @default("GRANT")
  reason               String?
  grantedBy            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  CapabilityDefinition CapabilityDefinition @relation(fields: [capabilityDefId], references: [id])
  RoleGrant            RoleGrant            @relation(fields: [businessId, roleGrantId], references: [businessId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([roleGrantId, capabilityDefId])
  @@index([roleGrantId])
}

model Cart {
  id         String     @id @default(uuid())
  customerId String
  businessId String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  Empresa    Empresa    @relation(fields: [businessId], references: [id])
  Cliente    Cliente    @relation(fields: [customerId, businessId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  CartItem   CartItem[]

  @@unique([customerId, businessId])
  @@unique([businessId, id])
  @@index([businessId, customerId])
}

model CartItem {
  id         String   @id @default(uuid())
  businessId String
  cartId     String
  productoId String
  cantidad   Decimal  @db.Decimal(18, 4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Cart       Cart     @relation(fields: [businessId, cartId], references: [businessId, id], onDelete: Cascade, onUpdate: Restrict)
  Producto   Producto @relation(fields: [businessId, productoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([cartId, productoId])
  @@index([cartId])
}

model CierreCaja {
  id             String       @id @default(uuid())
  empresaId      String
  aperturaCajaId String       @unique
  usuarioId      String
  fechaCierre    DateTime     @default(now())
  montoFinal     Decimal      @db.Decimal(18, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  AperturaCaja   AperturaCaja @relation(fields: [empresaId, aperturaCajaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Usuario        Usuario      @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  /// ADR-DAT-020 (Fase 2 PR 4, module 4a): the one-to-one reference carries the business.
  @@unique([empresaId, aperturaCajaId])
}

model Cliente {
  id                      String                    @id @default(uuid())
  empresaId               String
  nombre                  String
  email                   String?
  telefono                String?
  direccion               String?
  limiteCredito           Decimal?                  @db.Decimal(18, 2)
  activo                  Boolean                   @default(true)
  /// E2b — when this customer last left the store chat («últ. vez», seen by the team only).
  lastSeenAt              DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  condicionIva            String?
  cuit                    String?
  esMayorista             Boolean                   @default(false)
  estadoLegajo            EstadoLegajo?
  googleId                String?                   @unique
  passwordHash            String?
  razonSocial             String?
  Cart                    Cart[]
  CustomerLabelAssignment CustomerLabelAssignment[]
  Empresa                 Empresa                   @relation(fields: [empresaId], references: [id])
  ConversationParticipant ConversationParticipant[]
  CuentaCorriente         CuentaCorriente[]
  Deuda                   Deuda[]
  DevolucionCliente       DevolucionCliente[]
  Legajo                  Legajo?
  PushSubscription        PushSubscription[]
  Reaction                Reaction[]
  Message                 Message[]
  MessageReadReceipt      MessageReadReceipt[]
  MessagingReadPreference MessagingReadPreference[]
  Pedido                  Pedido[]
  Venta                   Venta[]
  PhoneNumber             PhoneNumber[]
  SMSAlert                SMSAlert[]
  EmailPreference         EmailPreference?          @relation("EmailPreference_cliente")

  compradorId String?
  Comprador   Comprador? @relation(fields: [compradorId], references: [id])

  @@unique([empresaId, email])
  @@unique([empresaId, compradorId])
  @@unique([id, empresaId])
}

model Compra {
  id                     String                @id @default(uuid())
  empresaId              String
  proveedorId            String
  usuarioId              String
  estado                 EstadoCompra          @default(BORRADOR)
  total                  Decimal               @db.Decimal(18, 2)
  fechaOrden             DateTime              @default(now())
  fechaRecepcionEsperada DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  fechaVencimientoPago   DateTime?
  numeroFactura          String?
  saldo                  Decimal               @default(0) @db.Decimal(18, 2)
  totalPagado            Decimal               @default(0) @db.Decimal(18, 2)
  Empresa                Empresa               @relation(fields: [empresaId], references: [id])
  Proveedor              Proveedor             @relation(fields: [empresaId, proveedorId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Usuario                Usuario               @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  CompraItem             CompraItem[]
  DevolucionProveedor    DevolucionProveedor[]
  PagoProveedor          PagoProveedor[]
  RecepcionCompra        RecepcionCompra[]

  @@unique([empresaId, id])
}

model CompraItem {
  id               String   @id @default(uuid())
  empresaId        String
  compraId         String
  productoId       String
  cantidadPedida   Decimal  @db.Decimal(18, 4)
  cantidadRecibida Decimal  @default(0) @db.Decimal(18, 4)
  costoUnitario    Decimal  @db.Decimal(18, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  Compra           Compra   @relation(fields: [empresaId, compraId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Producto         Producto @relation(fields: [empresaId, productoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
}

model Conversation {
  id                      String                    @id @default(uuid())
  businessId              String
  type                    MessagingConversationType
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?
  /// E6 — the team member in charge of this chat (Owner/Admin assign it); null: nobody yet.
  assignedUserId          String?
  assignedAt              DateTime?
  Empresa                 Empresa                   @relation(fields: [businessId], references: [id])
  Assignee                Membership?               @relation("ConversationAssignee", fields: [assignedUserId, businessId], references: [userId, businessId], onDelete: Restrict, onUpdate: Restrict)
  ConversationAssociation ConversationAssociation[]
  ConversationParticipant ConversationParticipant[]
  ConversationPreference  ConversationPreference[]
  Message                 Message[]

  @@unique([id, businessId])
  @@index([businessId, assignedUserId])
  @@index([businessId, deletedAt])
  @@index([businessId, updatedAt])
}

model ConversationAssociation {
  id             String                   @id @default(uuid())
  conversationId String
  businessId     String
  entityType     MessagingAssociationType
  entityId       String
  active         Boolean                  @default(true)
  changedBy      String?
  reason         String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  Conversation   Conversation             @relation(fields: [conversationId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: Restrict)

  @@index([businessId, conversationId, active])
  @@index([businessId, entityType, entityId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ConversationParticipant {
  id                    String                 @id @default(uuid())
  conversationId        String
  businessId            String
  userId                String?
  customerId            String?
  joinedAt              DateTime               @default(now())
  leftAt                DateTime?
  removedAt             DateTime?
  isAdmin               Boolean                @default(false)
  Conversation          Conversation           @relation(fields: [conversationId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: Restrict)
  Cliente               Cliente?               @relation(fields: [customerId, businessId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  Membership            Membership?            @relation(fields: [userId, businessId], references: [userId, businessId], onDelete: Restrict, onUpdate: Restrict)
  ConversationReadState ConversationReadState?

  /// E2: lets ConversationReadState carry the business in its reference (ADR-DAT-020).
  @@unique([id, businessId])
  @@index([businessId, customerId])
  @@index([businessId, userId])
  @@index([conversationId, joinedAt])
  @@index([conversationId, leftAt])
}

/// E6 — how one team member keeps a chat in their own inbox, like WhatsApp: pinned on top,
/// archived out of the way, or muted (no sound, push or e-mail) until a time. Personal: what
/// one person does never changes anyone else's inbox.
model ConversationPreference {
  id             String       @id @default(uuid())
  businessId     String
  conversationId String
  userId         String
  pinnedAt       DateTime?
  archivedAt     DateTime?
  mutedUntil     DateTime?
  updatedAt      DateTime     @updatedAt
  Conversation   Conversation @relation(fields: [conversationId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: Restrict)
  Membership     Membership   @relation(fields: [userId, businessId], references: [userId, businessId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([conversationId, userId])
  @@index([businessId, userId])
}

/// E6 — the Business's customer labels («Mayorista», «VIP»…), made by Owner/Admin. Only the
/// team ever sees them.
model CustomerLabel {
  id                      String                    @id @default(uuid())
  businessId              String
  nombre                  String
  /// One of the chat's label colours (see messaging/labels.ts).
  color                   String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  Empresa                 Empresa                   @relation(fields: [businessId], references: [id])
  CustomerLabelAssignment CustomerLabelAssignment[]

  @@unique([id, businessId])
  @@unique([businessId, nombre])
}

/// E6 — a label put on a customer (anyone on the team).
model CustomerLabelAssignment {
  id            String        @id @default(uuid())
  businessId    String
  labelId       String
  customerId    String
  createdAt     DateTime      @default(now())
  CustomerLabel CustomerLabel @relation(fields: [labelId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: Restrict)
  Cliente       Cliente       @relation(fields: [customerId, businessId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([labelId, customerId])
  @@index([businessId, customerId])
}

/// E2 (messaging like WhatsApp) — how far one participant got in its conversation: up to which
/// message it reached their screen (✓✓) and up to which they read it. Kept apart from read
/// receipts (MessageReadReceipt), so the unread count works even with receipts turned off, and
/// apart from the participant row, which the API returns: positions are never sent raw.
/// Positions are message creation times. Goes with its participant when it is deleted.
model ConversationReadState {
  id                      String                  @id @default(uuid())
  participantId           String
  businessId              String
  lastDeliveredAt         DateTime?
  lastReadAt              DateTime?
  /// E3 — when this participant was last e-mailed about unread customer messages; one mail
  /// per run of unread messages.
  lastAlertedAt           DateTime?
  updatedAt               DateTime                @updatedAt
  ConversationParticipant ConversationParticipant @relation(fields: [participantId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: Restrict)

  @@unique([participantId, businessId])
  @@index([businessId])
}

model CuentaCorriente {
  id        String   @id @default(uuid())
  empresaId String
  clienteId String
  saldo     Decimal  @default(0) @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Cliente   Cliente  @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  Empresa   Empresa  @relation(fields: [empresaId], references: [id])
  Deuda     Deuda[]
  Pago      Pago[]

  @@unique([empresaId, clienteId])
  /// ADR-DAT-020 (Fase 2 PR 4, module 4a): lets references carry the business.
  @@unique([empresaId, id])
}

model Deuda {
  id                String           @id @default(uuid())
  empresaId         String
  clienteId         String
  ventaId           String?
  montoTotal        Decimal          @db.Decimal(18, 2)
  montoPendiente    Decimal          @db.Decimal(18, 2)
  fechaVencimiento  DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  cuentaCorrienteId String?
  AplicacionPago    AplicacionPago[]
  Cliente           Cliente          @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  CuentaCorriente   CuentaCorriente? @relation(fields: [empresaId, cuentaCorrienteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Empresa           Empresa          @relation(fields: [empresaId], references: [id])
  Venta             Venta?           @relation(fields: [empresaId, ventaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  /// ADR-DAT-020 (Fase 2 PR 4, module 4a): lets references carry the business.
  @@unique([empresaId, id])
}

model DevolucionCliente {
  id                String           @id @default(uuid())
  empresaId         String
  negocioId         String?
  clienteId         String
  ventaId           String
  creadoPorId       String
  numeroDevolucion  Int?
  estado            EstadoDevolucion @default(SOLICITADA)
  fechaSolicitud    DateTime         @default(now())
  fechaAutorizacion DateTime?
  fechaRecibida     DateTime?
  fechaProcesada    DateTime?
  ventaFecha        DateTime
  diasDesdeVenta    Int?
  montoTotal        Decimal          @db.Decimal(18, 2)
  montoComisiones   Decimal          @default(0) @db.Decimal(18, 2)
  montoReembolsable Decimal          @db.Decimal(18, 2)
  motivo            String
  observaciones     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdBy         String?

  Cliente               Cliente                 @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  Empresa               Empresa                 @relation(fields: [empresaId], references: [id])
  Venta                 Venta                   @relation(fields: [empresaId, ventaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  CreadoPor             Usuario?                @relation("DevolucionCliente_creadoPorIdToUsuario", fields: [empresaId, createdBy], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  DevolucionClienteItem DevolucionClienteItem[]
  Reembolso             Reembolso?

  @@unique([empresaId, numeroDevolucion])
  @@unique([empresaId, id])
  @@index([empresaId, estado])
  @@index([empresaId, clienteId])
  @@index([empresaId, ventaId])
  @@index([empresaId, createdAt])
  @@index([estado, fechaSolicitud])
}

model DevolucionClienteItem {
  id                     String   @id @default(uuid())
  empresaId              String
  devolucionClienteId    String
  ventaItemId            String
  productoId             String
  cantidad               Decimal  @db.Decimal(18, 4)
  precioUnitarioOriginal Decimal  @db.Decimal(18, 2)
  precioDevuelto         Decimal  @db.Decimal(18, 2)
  descuentoItem          Decimal  @default(0) @db.Decimal(18, 2)
  montoLineaDevuelto     Decimal  @db.Decimal(18, 2)
  motivo                 String?
  observaciones          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  DevolucionCliente DevolucionCliente @relation(fields: [empresaId, devolucionClienteId], references: [empresaId, id], onDelete: Cascade, onUpdate: Restrict)
  VentaItem         VentaItem         @relation(fields: [empresaId, ventaItemId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Producto          Producto          @relation(fields: [empresaId, productoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([devolucionClienteId, ventaItemId])
  @@index([devolucionClienteId])
  @@index([ventaItemId])
}

model Reembolso {
  id                  String          @id @default(uuid())
  devolucionClienteId String          @unique
  empresaId           String
  referenceId         String?
  estado              EstadoReembolso @default(PENDIENTE)
  montoReembolsable   Decimal         @db.Decimal(18, 2)
  montoActual         Decimal         @db.Decimal(18, 2)
  metodoReembolso     String?
  intentos            Int             @default(0)
  ultimoIntento       DateTime?
  proximoIntento      DateTime?
  resultado           String?
  motivoFalla         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  procesadoEn         DateTime?

  DevolucionCliente DevolucionCliente @relation(fields: [empresaId, devolucionClienteId], references: [empresaId, id], onDelete: Cascade, onUpdate: Restrict)
  Empresa           Empresa           @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, devolucionClienteId])
  @@index([empresaId, estado])
  @@index([empresaId, createdAt])
  @@index([estado, proximoIntento])
}

model DevolucionProveedor {
  id                      String                    @id @default(uuid())
  empresaId               String
  compraId                String
  proveedorId             String
  usuarioId               String
  motivo                  String
  fecha                   DateTime                  @default(now())
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  Compra                  Compra                    @relation(fields: [empresaId, compraId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Empresa                 Empresa                   @relation(fields: [empresaId], references: [id])
  Proveedor               Proveedor                 @relation(fields: [empresaId, proveedorId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  Usuario                 Usuario                   @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  DevolucionProveedorItem DevolucionProveedorItem[]

  @@unique([empresaId, id])
}

model DevolucionProveedorItem {
