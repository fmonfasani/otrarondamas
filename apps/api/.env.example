DATABASE_URL="postgresql://user:password@localhost:5500/otrarondamas?schema=public"
JWT_SECRET="supersecretjwtkey"
PORT=3000
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Login con Google (apps/api/src/auth/google.strategy.ts). Client ID/Secret
# desde Google Cloud Console > APIs & Servicios > Credenciales > crear un
# cliente OAuth tipo "Aplicación web" (NO "Escritorio", ese tipo no acepta
# redirect URIs http(s)).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Debe coincidir EXACTO (incluyendo el path) con un "Authorized redirect
# URI" configurado en ese cliente de Google.
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
# A dónde redirige el backend después del callback de Google (con el
# token en la query string) — el origen del frontend, no de la API.
FRONTEND_URL="http://localhost:5173"
# Empresa a la que se asigna un Usuario nuevo creado automáticamente por
# Google login (sin este valor, el alta automática falla explícitamente
# en vez de adivinar una empresa — ver auth.google.service.ts).
GOOGLE_SIGNUP_EMPRESA_ID=""

# RF-17 (docs/spec-login-roles.md) — Login, Roles del Negocio y Legajo.
# Carpeta del disco donde se guardan los documentos sensibles del legajo
# (certificado de antecedentes penales, constancia de CUIL) — SIEMPRE
# fuera del webroot, nunca servida directo por nginx (ver
# legajo.service.ts). Sin este valor, subir un documento falla
# explícito en vez de asumir una ruta por defecto para datos sensibles.
LEGAJO_STORAGE_DIR="./legajos-storage"

# Email transaccional para el link de invitación y las alertas de
# vencimiento de legajo (decisión D-20 resuelta: Resend). Sin estos dos
# valores, InvitacionesService.crear() sigue funcionando (la
# invitación se crea igual) pero el email no se envía — el dueño puede
# copiar el link de la respuesta y mandarlo a mano (ver email.service.ts).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""