{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testRegex": "test/.*\\.(e2e|integration)-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "detectOpenHandles": true,
  "forceExit": false,
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs|socket\\.io-client)/)"
  ]
}
