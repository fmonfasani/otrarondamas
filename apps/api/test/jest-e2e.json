{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/.*\\.(e2e|integration)-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "detectOpenHandles": true,
  "forceExit": false,
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs|socket\\.io-client)/)"
  ],
  "setupFilesAfterEnv": [
    "<rootDir>/test/setup-env.ts"
  ],
  "maxWorkers": "50%",
  "testTimeout": 30000,
  "verbose": true,
  "bail": false
}
