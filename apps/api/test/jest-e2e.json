{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testRegex": "test/.*\\.(e2e|integration)-spec\\.ts$",
  "transform": {
    "^.+\\.tsx?$": "<rootDir>/jest-esm-transformer.cjs"
  },
  "testEnvironment": "node",
  "detectOpenHandles": true,
  "forceExit": false,
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs|socket\\.io-client)/)"
  ],
  "maxWorkers": "50%",
  "testTimeout": 30000,
  "verbose": true,
  "bail": false,
  "preset": "ts-jest/presets/default-esm",
  "extensionsToTreatAsEsm": [
    ".ts"
  ]
}
