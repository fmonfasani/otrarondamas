# ============================================================================
# Wapsell Remix — Production Environment Template
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.production (DO NOT commit the real file)
# 2. Replace all <placeholder> values with production secrets
# 3. For Docker deployments, pass these as environment variables or mounted secrets
# 4. Never log or expose these values
# ============================================================================

# === Node.js Runtime ===
NODE_ENV=production
PORT=3000

# === API Configuration ===
# Internal: http://api:3000 (within Docker network)
# External: https://api.wapsell.com (production domain)
# In Docker Compose, use service name; on Kubernetes, use Service DNS
VITE_API_URL=http://api:3000

# Request timeout in milliseconds (30s recommended for external APIs)
VITE_API_TIMEOUT=30000

# === Internationalization ===
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,en

# === Session Management ===
# CRITICAL: Use a cryptographically random string (minimum 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<replace-with-random-32-byte-hex-string>

# === Logging & Monitoring ===
LOG_LEVEL=info
# Options: error, warn, info, debug, trace

# === Deployment Tracking ===
# Helps identify which version is running (Git SHA, semantic version, etc.)
APP_VERSION=1.0.0
DEPLOYMENT_ENV=production
BUILD_ID=<git-sha-or-build-number>

# === Optional: Feature Flags ===
# Enable/disable experimental features without redeployment
FEATURE_CHAT_ENABLED=true
FEATURE_POS_ENABLED=true
FEATURE_TIENDA_ENABLED=true

# === Optional: Sentry/Error Tracking ===
SENTRY_DSN=<your-sentry-dsn>
SENTRY_ENVIRONMENT=production
SENTRY_TRACE_SAMPLE_RATE=0.1

# === Optional: Analytics ===
ANALYTICS_ENABLED=true
ANALYTICS_ENDPOINT=https://analytics.wapsell.com

# ============================================================================
# SECURITY CHECKLIST:
# ============================================================================
# ✅ Never commit real .env.production (add to .gitignore)
# ✅ Rotate SESSION_SECRET regularly
# ✅ Use HTTPS for all external API URLs in production
# ✅ Validate all environment variables at startup
# ✅ Use Docker Compose secrets or Kubernetes Secrets for sensitive data
# ✅ Audit logs for any .env exposure
# ✅ Use different secrets per environment (dev ≠ staging ≠ production)
# ============================================================================
