# API Configuration
VITE_API_URL=http://localhost:8600
VITE_API_TIMEOUT=30000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/otrarondamas

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-key-here

# i18n
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,en

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_SSL=false
KAFKA_SASL_ENABLED=false
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Deployment
NODE_ENV=development
PORT=3000

# Mercado Pago Configuration (Payment Gateway)
MERCADOPAGO_ACCESS_TOKEN=your_mp_access_token_here
MERCADOPAGO_WEBHOOK_SECRET=your_mp_webhook_secret_here

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key_here
