# ═══════════════════════════════════════════════════════════════════════════
# WAPSELL HETZNER PRODUCTION ENVIRONMENT VARIABLES
#
# Copy this file to /var/www/wapsell/.env and fill in with actual values
# DO NOT COMMIT THIS FILE TO GIT
#
# Author: Claude Haiku 4.5
# Date: 2026-10-26
# ═══════════════════════════════════════════════════════════════════════════

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# APPLICATION CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Node environment
NODE_ENV=production

# API Port
PORT=3000

# API Base URL (used for CORS, emails, etc.)
API_URL=https://api.yourdomain.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DATABASE CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# PostgreSQL Connection String
# Format: postgresql://[user[:password]@][host][:port]/[database]
DATABASE_URL=postgresql://wapsell_user:strong_password_here@localhost:5432/wapsell_prod

# Optional: Connection pool settings
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AUTHENTICATION & SECURITY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# JWT Configuration
# Generate with: openssl rand -base64 32
JWT_SECRET=generate_a_strong_secret_here_with_openssl_rand_base64_32

# JWT Token Expiration
JWT_EXPIRATION=24h

# JWT Refresh Token Secret
JWT_REFRESH_SECRET=generate_another_strong_secret_here_with_openssl_rand_base64_32

# JWT Refresh Token Expiration
JWT_REFRESH_EXPIRATION=7d

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# EMAIL CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# SendGrid API Key (for email sending)
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Resend API Key (alternative email provider)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email sender address
EMAIL_FROM=noreply@yourdomain.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SMS CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Twilio Configuration (for SMS)
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AWS CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# AWS Credentials (for S3, SES, etc.)
# Get from: https://console.aws.amazon.com/iam
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# AWS S3 Configuration
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=us-east-1

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# EXTERNAL INTEGRATIONS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Google OAuth Configuration (for login)
# Get from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Callback URL
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LOGGING & MONITORING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Log Level
LOG_LEVEL=info

# Enable request logging
LOG_REQUESTS=true

# Elasticsearch Configuration (for logs)
# ELASTICSEARCH_HOST=localhost
# ELASTICSEARCH_PORT=9200
# ELASTICSEARCH_USER=elastic
# ELASTICSEARCH_PASSWORD=your_password

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# REDIS CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Redis Connection (for caching, sessions, etc.)
REDIS_URL=redis://localhost:6379

# Redis Password (if required)
# REDIS_PASSWORD=your_redis_password

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CORS & SECURITY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# CORS Origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com,https://store.yourdomain.com

# CORS Credentials
CORS_CREDENTIALS=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# RATE LIMITING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Rate limit requests per minute
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FEATURE FLAGS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Enable/disable features
FEATURE_SWAGGER_UI=true
FEATURE_HEALTH_CHECK=true
FEATURE_METRICS=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BUSINESS CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Company/Tenant Configuration
COMPANY_NAME=Otra Ronda Más
COMPANY_URL=https://yourdomain.com

# ═══════════════════════════════════════════════════════════════════════════
# SETUP INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════════════════
#
# 1. Copy this file to /var/www/wapsell/.env
# 2. Replace all "your_*" values with actual credentials
# 3. Generate strong secrets:
#    - JWT_SECRET: openssl rand -base64 32
#    - JWT_REFRESH_SECRET: openssl rand -base64 32
# 4. Test database connection:
#    - psql $DATABASE_URL -c "SELECT 1"
# 5. Restart application:
#    - pm2 restart wapsell
# 6. Verify logs:
#    - pm2 logs wapsell
#
# ═══════════════════════════════════════════════════════════════════════════
# SECURITY NOTES
# ═══════════════════════════════════════════════════════════════════════════
#
# ✅ DO:
# - Keep .env file secure (chmod 600)
# - Use strong, unique passwords
# - Rotate secrets regularly
# - Store in encrypted backup
# - Audit access logs
#
# ❌ DON'T:
# - Commit .env to git
# - Share credentials with teammates
# - Use weak passwords
# - Log sensitive values
# - Store in plain text backups
#
# ═══════════════════════════════════════════════════════════════════════════

