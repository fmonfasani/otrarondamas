# Wapsell Admin Onboarding Test Suite - Configuration
# For development testing only - DO NOT commit to version control

# API Configuration
API_BASE_URL="http://localhost:3001/businesses/otrarondamas/api"
BUSINESS_HANDLE="otrarondamas"

# Admin Authentication (Test Account)
ADMIN_EMAIL="admin@otrarondamas.test"
ADMIN_PASSWORD="TestPassword123!"

# Test User Configuration
TEST_SELLER_EMAIL="seller@otrarondamas.com"
TEST_SELLER_NAME="Seller Test"
