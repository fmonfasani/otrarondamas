  "testScenarios": [
    {
      "id": "scenario-001",
      "name": "Complete Onboarding Flow",
      "description": "Test full admin onboarding: login, user creation, role assignment, dashboard access",
      "steps": [
        "admin_login",
        "verify_business_exists",
        "fetch_company_info",
        "list_existing_roles",
        "create_test_role",
        "create_test_user",
        "assign_role_to_user",
        "verify_user_login",
        "access_dashboard",
        "fetch_audit_logs"
      ]
    },
    {
      "id": "scenario-002",
      "name": "Permission Verification",
      "description": "Verify role-based access control and permission enforcement",
      "steps": [
        "admin_login",
        "create_minimal_role",
        "create_restricted_user",
        "test_restricted_access",
        "verify_permission_denial"
      ]
    },
    {
      "id": "scenario-003",
      "name": "Multi-User Concurrent Access",
      "description": "Test simultaneous authentication of multiple users",
      "steps": [
        "create_user_accounts",
        "authenticate_all_users",
        "verify_independent_sessions",
        "cleanup_test_accounts"
      ]
    }
  ],
