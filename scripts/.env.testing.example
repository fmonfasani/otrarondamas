##############################################################################
# Wapsell Admin Onboarding Test Suite - Configuration Template
#
# Purpose: Define environment-specific configuration for automated testing
#
# Instructions:
#   1. Copy this file to .env.testing
#   2. Update values for your test environment
#   3. Ensure secrets are NOT checked into version control
#   4. Use environment-specific files: .env.testing.development,
#      .env.testing.staging, .env.testing.production
#
# Security Notes:
#   - NEVER commit .env.testing files to git
#   - Use test accounts only, never production credentials
#   - Rotate test passwords regularly
#   - Monitor API logs for test activity
#
##############################################################################

# API Configuration
# ================

# Base URL of the Wapsell API for the target business
# Development: http://localhost:3000/businesses/otrarondamas/api
# Staging:     https://api-staging.otrarondamas.wapsell.com/businesses/otrarondamas/api
# Production:  https://api.otrarondamas.wapsell.com/businesses/otrarondamas/api
API_BASE_URL="https://api.otrarondamas.wapsell.com/businesses/otrarondamas/api"

# Business identifier/handle in the Wapsell platform
BUSINESS_HANDLE="otrarondamas"

# Admin Authentication
# ====================

# Test admin email address (should be an existing admin account)
ADMIN_EMAIL="admin@otrarondamas.test"

# Test admin password
ADMIN_PASSWORD="change-me-to-secure-password"

# Test User Configuration
# =======================

# Test seller user email (will be created during tests if needed)
TEST_SELLER_EMAIL="vendedor@otrarondamas.test"

# Test seller user full name
TEST_SELLER_NAME="Vendedor Test"

# Test seller password
TEST_SELLER_PASSWORD="change-me-to-secure-password"

# Test role configuration
TEST_ROLE_NAME="Gerente"
TEST_ROLE_PERMISSIONS="catalog:read,sales:read,cash-register:write"

# Test Data Configuration
# =======================

# Path to test users data file
TEST_DATA_FILE="test-data/users.json"

# Maximum wait time for async operations (seconds)
API_TIMEOUT=30

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY=2

# Logging and Output
# ==================

# Report output directory
REPORT_DIR="./reports"

# Enable debug logging (true/false)
DEBUG=false

# Verbosity level (quiet, normal, verbose, debug)
LOG_LEVEL="normal"
