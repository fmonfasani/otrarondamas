# Plantilla de configuración para docker-compose.wapsell.yml
#
# Copiar a .env.wapsell en el mismo directorio y completar con valores reales.
# NO commitear el .env.wapsell real (contiene secretos).
#
# Valores de ejemplo marcados con [GENERAR] deben crearse nuevo per deploy:
#   POSTGRES_PASSWORD: openssl rand -base64 32
#   JWT_SECRET: openssl rand -hex 32
#   REDIS_PASSWORD: openssl rand -base64 24
#   ELASTICSEARCH_PASSWORD: openssl rand -base64 32

# ============================================================================
# ENTORNO
# ============================================================================
NODE_ENV=production
LOG_LEVEL=info


# ============================================================================
# BASE DE DATOS (PostgreSQL 16)
# ============================================================================
# Usuario de BD (no cambiar en producción una vez configurado)
POSTGRES_USER=wapsell_prod

# Contraseña fuerte, aleatoria, única por deploy [GENERAR]
POSTGRES_PASSWORD=

# Pool de conexiones: máximo 20 conexiones simultáneas (API)
# Para un VPS pequeño (2 CPUs) es suficiente; escalar si hay timeouts
DATABASE_POOL_SIZE=20
DATABASE_STATEMENT_CACHE_SIZE=200


# ============================================================================
# CACHE DISTRIBUIDO (Redis 7)
# ============================================================================
# Contraseña de Redis [GENERAR]: openssl rand -base64 24
# Requerida para autenticar accesos (ACL habilitado)
REDIS_PASSWORD=

# Tamaño máximo del store en memoria (2GB por defecto)
REDIS_MAX_MEMORY=2gb

# Política de evicción (allkeys-lru: elimina claves menos usadas)
REDIS_EVICTION_POLICY=allkeys-lru


# ============================================================================
# BÚSQUEDA E INDEXACIÓN (Elasticsearch 8)
# ============================================================================
# Contraseña de usuario elastic [GENERAR]: openssl rand -base64 32
ELASTICSEARCH_PASSWORD=

# Asignar 1GB de heap a Elasticsearch (8GB disponible en el host)
ELASTICSEARCH_HEAP_SIZE=1g


# ============================================================================
# API NestJS (3000)
# ============================================================================
API_PORT=3000

# URL pública de la API (usada en JWT, emails, CORS, etc.)
# Ejemplo: https://api.wapsell.com
API_BASE_URL=https://api.wapsell.com

# API version (para versionado de endpoints)
API_VERSION=v1

# Secreto para firmar JWT (mínimo 32 caracteres) [GENERAR]
# openssl rand -hex 32
JWT_SECRET=

# Tiempo de expiración del token (segundos): 1 hora
JWT_EXPIRATION=3600

# Secreto para refresh tokens [GENERAR]: openssl rand -hex 32
JWT_REFRESH_SECRET=

# Tiempo de expiración de refresh token (segundos): 7 días
JWT_REFRESH_EXPIRATION=604800

# Orígenes CORS permitidos (separados por coma)
# Incluir: tienda online, panel admin, localhost para dev
CORS_ORIGINS=https://wapsell.com,https://admin.wapsell.com,http://localhost:3001,http://localhost:3002,http://localhost:3000


# ============================================================================
# AUTENTICACIÓN (Google OAuth 2.0)
# ============================================================================
# Obtener en https://console.cloud.google.com/apis/credentials
# Tipo: OAuth 2.0 Client ID > Aplicación web

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Callback URL registrado en Google Cloud Console
# Patrón: https://{API_BASE_URL}/auth/google/callback
GOOGLE_CALLBACK_URL=https://api.wapsell.com/auth/google/callback


# ============================================================================
# PAGOS (P11-payment)
# ============================================================================

# Stripe: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_

# Público (se usa en el frontend)
STRIPE_PUBLISHABLE_KEY=pk_live_

# Webhook secret para validar eventos de Stripe
# https://dashboard.stripe.com/webhooks > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_

# MercadoPago: https://www.mercadopago.com/developers
MERCADOPAGO_ACCESS_TOKEN=APP_USR_

# Público (se usa en el frontend)
MERCADOPAGO_PUBLIC_KEY=APP_USR_


# ============================================================================
# ALMACENAMIENTO (AWS S3 / P12-cdn)
# ============================================================================
# Bucket para CDN de imágenes/documentos
# Patrón: {project}-assets-{stage}
AWS_S3_BUCKET=wapsell-assets-prod

# Región donde está el bucket (ej: eu-central-1, us-east-1)
AWS_REGION=eu-central-1

# Acceso a S3 (IAM user con permisos s3:GetObject, s3:PutObject)
# Generar en https://console.aws.amazon.com/iam/home#/users
AWS_ACCESS_KEY_ID=AKIA

AWS_SECRET_ACCESS_KEY=

# (Opcional) Si usas un S3-compatible (MinIO, DigitalOcean Spaces, etc.)
# AWS_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com


# ============================================================================
# EMAIL TRANSACCIONAL (Resend)
# ============================================================================
# Resend: https://resend.com > API Keys
# Uso: invitaciones, alertas, notificaciones
RESEND_API_KEY=

# Dominio verificado en Resend (ej: noreply@wapsell.com)
RESEND_FROM_EMAIL=noreply@wapsell.com


# ============================================================================
# INTERNACIONALIZACIÓN (P13-i18n)
# ============================================================================
# Locale por defecto
DEFAULT_LOCALE=es-AR

# Locales soportados (separados por comas)
SUPPORTED_LOCALES=es-AR,en-US,pt-BR


# ============================================================================
# FRONTENDS (Vite build args)
# ============================================================================

# Tienda online (B2C)
# URL de la API usado en el build de Vite (incrustado en el bundle)
VITE_API_URL_TIENDA=https://api.wapsell.com

# Clave pública de Stripe (incrustado en el bundle de la tienda)
VITE_STRIPE_PUBLIC_KEY=pk_live_

# Panel administrativo (B2B, interno)
# URL de la API para el panel
VITE_API_URL_ADMIN=https://api.wapsell.com


# ============================================================================
# OBSERVABILIDAD (Logging, métricas, tracing)
# ============================================================================
# Nivel de log: debug, info, warn, error
LOG_LEVEL=info

# Formato: text, json (json recomendado para producción)
LOG_FORMAT=json

# Directorio interno de logs (volumen /app/logs)
LOG_DIR=/app/logs


# ============================================================================
# RATE LIMITING
# ============================================================================
# Ventana de tiempo para contar requests (ms)
RATE_LIMIT_WINDOW_MS=900000

# Máximo de requests por ventana (per IP)
RATE_LIMIT_MAX_REQUESTS=100


# ============================================================================
# OPCIONALES: Stripe Webhook Local (desarrollo)
# ============================================================================
# En desarrollo local, usar stripe-cli para simular webhooks:
#   stripe listen --forward-to localhost:3000/webhooks/stripe
# En producción, registrar en https://dashboard.stripe.com/webhooks
# STRIPE_WEBHOOK_ID=whsec_test_...


# ============================================================================
# NOTAS OPERATIVAS
# ============================================================================
#
# 1. SECRETOS CRÍTICOS (cambiar si hay compromiso):
#    - POSTGRES_PASSWORD
#    - JWT_SECRET
#    - JWT_REFRESH_SECRET
#    - REDIS_PASSWORD
#    - ELASTICSEARCH_PASSWORD
#    - AWS_SECRET_ACCESS_KEY
#    - STRIPE_SECRET_KEY
#    - STRIPE_WEBHOOK_SECRET
#    - MERCADOPAGO_ACCESS_TOKEN
#    - RESEND_API_KEY
#
# 2. CAMBIOS SIN DOWNTIME:
#    - CORS_ORIGINS: modificar .env y reiniciar API (docker compose restart api)
#    - LOG_LEVEL, LOG_FORMAT: modificar y reiniciar
#    - RATE_LIMIT_*: modificar y reiniciar
#
# 3. CAMBIOS CON DOWNTIME (requieren rebuild):
#    - VITE_API_URL_*: requieren reconstruir frontend
#    - Versiones de Docker images (postgres, redis, elasticsearch)
#
# 4. RESPALDO DE DATOS:
#    - PostgreSQL: docker compose exec postgres pg_dump -U wapsell_prod wapsell_prod > backup.sql
#    - Redis: docker volume inspect wapsell_redis_data (ubicación en host)
#    - Elasticsearch: ver elastic.co/guide/backup
#
# 5. MONITOREO:
#    - docker compose logs -f api
#    - docker compose stats
#    - curl http://localhost:3000/health (API)
#    - psql -h 127.0.0.1 -U wapsell_prod -d wapsell_prod (DB)
