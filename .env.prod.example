# Copiar a .env junto a docker-compose.prod.yml en el servidor y completar
# con valores reales. No commitear el .env real.

# Generar con: openssl rand -base64 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Dominios que la API acepta como origen (CORS) — desde el corte de
# dominios (RF-06) son DOS: la tienda pública en la raíz y el panel
# interno en admin.*. Sin admin.* acá, pos-admin no puede llamar a la
# API desde el navegador (CORS lo bloquea antes de llegar al backend).
CORS_ORIGINS=https://otrarondamas.wapsell.com,https://admin.otrarondamas.wapsell.com

# URLs públicas de la API que cada frontend usa en runtime del
# navegador — dos build args distintos porque son dos apps separadas
# (apps/tienda-online y apps/pos-admin), aunque hablen con la MISMA
# API. Se incrustan en el build de Vite, no son env vars de contenedor
# en runtime — cambiar esto requiere reconstruir la imagen, no solo
# reiniciar el contenedor.
VITE_API_URL_TIENDA=https://api.otrarondamas.wapsell.com
VITE_API_URL_ADMIN=https://api.otrarondamas.wapsell.com

# Login con Google (apps/api/src/auth/google.strategy.ts). Client ID/Secret
# desde Google Cloud Console > APIs & Servicios > Credenciales > cliente
# OAuth tipo "Aplicación web" (NO "Escritorio"). El redirect URI de acá
# tiene que estar agregado EXACTO en ese cliente ("Authorized redirect
# URIs"), o Google rechaza el callback con redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.otrarondamas.wapsell.com/auth/google/callback
# El login con Google es una función del panel interno (pos-admin), no
# de la tienda pública — FRONTEND_URL apunta a admin.* desde el corte
# de dominios, no a la raíz.
FRONTEND_URL=https://admin.otrarondamas.wapsell.com
# Empresa a la que se asigna un Usuario nuevo creado automáticamente por
# Google login — buscar el id real con Empresa.findMany() contra la DB
# de producción, no asumir un valor.
GOOGLE_SIGNUP_EMPRESA_ID=
# Empresa cuyo catálogo/pedidos expone la tienda pública (RF-06, ver
# tienda.service.ts) — mismo criterio que GOOGLE_SIGNUP_EMPRESA_ID, una
# sola tienda pública por deploy. Sin esta variable, /tienda/* responde
# 500 explícito en vez de mostrar un catálogo adivinado.
TIENDA_EMPRESA_ID=
