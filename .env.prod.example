# Copiar a .env junto a docker-compose.prod.yml en el servidor y completar
# con valores reales. No commitear el .env real.

# Generar con: openssl rand -base64 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Dominio del frontend, para que la API acepte requests desde ahí (CORS).
# Separar varios orígenes con coma si hace falta.
CORS_ORIGINS=https://otrarondamas.wapsell.com

# URL pública de la API que el frontend usa en runtime del navegador.
# Se incrusta en el build de Vite (build arg), no es una env var de
# contenedor en runtime.
VITE_API_URL=https://api.otrarondamas.wapsell.com

# Login con Google (apps/api/src/auth/google.strategy.ts). Client ID/Secret
# desde Google Cloud Console > APIs & Servicios > Credenciales > cliente
# OAuth tipo "Aplicación web" (NO "Escritorio"). El redirect URI de acá
# tiene que estar agregado EXACTO en ese cliente ("Authorized redirect
# URIs"), o Google rechaza el callback con redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.otrarondamas.wapsell.com/auth/google/callback
FRONTEND_URL=https://otrarondamas.wapsell.com
# Empresa a la que se asigna un Usuario nuevo creado automáticamente por
# Google login — buscar el id real con Empresa.findMany() contra la DB
# de producción, no asumir un valor.
GOOGLE_SIGNUP_EMPRESA_ID=
