# Build de producción de la tienda online (Vite/React) servido por nginx.
# Se construye con el contexto en la raíz del monorepo porque depende de
# packages/shared-types. VITE_API_URL se pasa como build arg: Vite
# incrusta las env vars en el bundle al momento de compilar, no en runtime.

FROM node:20-alpine AS builder
WORKDIR /repo

COPY package.json tsconfig.base.json ./
COPY apps/tienda-online/package.json apps/tienda-online/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
COPY packages/ui-kit/package.json packages/ui-kit/package.json
RUN if [ -f package-lock.json ]; then npm ci --legacy-peer-deps --prefer-offline; else npm install --legacy-peer-deps --prefer-offline; fi

COPY packages/shared-types packages/shared-types
COPY packages/ui-kit packages/ui-kit
COPY apps/tienda-online apps/tienda-online

RUN npm run build --workspace=@otrarondamas/ui-kit

ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build --workspace=@otrarondamas/tienda-online

# ---------------------------------------------------------------------------

FROM nginx:alpine AS runner
COPY apps/tienda-online/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /repo/apps/tienda-online/dist /usr/share/nginx/html

EXPOSE 80
