{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "jsx": "react-jsx",
    "lib": ["es2020", "dom", "dom.iterable"],
    "strict": true,
    "noImplicitAny": false,
    "noEmit": false,
    "composite": true,
    "module": "ES2020",
    "moduleResolution": "node"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.tsx", "src/**/*.stories.tsx"]
}