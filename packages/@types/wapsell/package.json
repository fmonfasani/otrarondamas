{
  "name": "@wapsell/types",
  "version": "0.0.1",
  "description": "Single source of truth for Wapsell types across all applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "lint": "eslint src/**/*.ts --fix"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./tenant": {
      "types": "./dist/tenant.d.ts",
      "default": "./dist/tenant.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "default": "./dist/dashboard.js"
    },
    "./pos": {
      "types": "./dist/pos.d.ts",
      "default": "./dist/pos.js"
    },
    "./tienda": {
      "types": "./dist/tienda.d.ts",
      "default": "./dist/tienda.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "default": "./dist/common.js"
    }
  },
  "devDependencies": {
    "typescript": "^5.1.3",
    "zod": "^3.22.0",
    "eslint": "^8.42.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "zod": "^3.22.0"
  }
}
