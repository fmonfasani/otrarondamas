{
  "uid": "wapsell-app",
  "title": "Wapsell: API y chat",
  "tags": [
    "wapsell"
  ],
  "timezone": "America/Argentina/Buenos_Aires",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "La misma información que la página Rendimiento del panel de la plataforma: un resumen por minuto (30 días).",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Tiempo de respuesta de la API",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wapsell-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 300
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wapsell-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(at, $__interval), max(\"p95Ms\") AS \"95 %\", avg(\"p50Ms\") AS \"Mitad\" FROM \"PerformanceMinute\" WHERE $__timeFilter(at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Pedidos y errores por minuto",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wapsell-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wapsell-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(at, $__interval), avg(requests) AS \"Pedidos\", avg(\"errors5xx\") AS \"Errores del servidor\" FROM \"PerformanceMinute\" WHERE $__timeFilter(at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Chat: mensajes y conectados",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wapsell-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wapsell-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(at, $__interval), sum(messages) AS \"Mensajes\", max(online) AS \"Conectados\" FROM \"PerformanceMinute\" WHERE $__timeFilter(at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Chat: respuesta del negocio",
      "description": "Lo que tarda el equipo en contestarle a un cliente (sin los mensajes automáticos).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wapsell-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wapsell-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(at, $__interval), avg(\"replyP50Ms\") AS \"Mitad\", max(\"replyP95Ms\") AS \"95 %\" FROM \"PerformanceMinute\" WHERE $__timeFilter(at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API: procesador, memoria y bloqueos",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wapsell-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wapsell-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(at, $__interval), avg(\"cpuPct\") AS \"Procesador (% de uno)\", max(\"loopP99Ms\") AS \"Bloqueo (ms)\" FROM \"PerformanceMinute\" WHERE $__timeFilter(at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Base de datos",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wapsell-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wapsell-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(at, $__interval), avg(\"dbPingMs\") AS \"Pregunta mínima (ms)\", max(\"dbConns\") AS \"Conexiones\" FROM \"PerformanceMinute\" WHERE $__timeFilter(at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Rutas más lentas (último minuto guardado)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wapsell-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wapsell-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r->>'ruta' AS \"Ruta\", (r->>'cantidad')::int AS \"Pedidos\", (r->>'promedioMs')::float AS \"Promedio (ms)\", (r->>'p95Ms')::float AS \"95 % (ms)\", (r->>'errores')::int AS \"Errores\" FROM (SELECT routes FROM \"PerformanceMinute\" ORDER BY at DESC LIMIT 1) m, jsonb_array_elements(m.routes) r ORDER BY 4 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}
