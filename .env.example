# Wapsell Consolidated Environment - Template

# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Database
DB_USER=wapsell
DB_PASSWORD=your-secure-password-here
DB_NAME=otrarondamas
DB_PORT=5432
DB_HOST=postgres
DATABASE_URL=postgresql://wapsell:your-secure-password-here@postgres:5432/otrarondamas

# JWT & Security
JWT_SECRET=your-jwt-secret-key-here-minimum-32-chars
JWT_EXPIRATION=3600
SESSION_SECRET=your-session-secret-here-minimum-32-chars
API_SECRET=your-api-secret-here

# API Configuration
NODE_ENV=development
API_PORT=8600
API_HOST=0.0.0.0
LOG_LEVEL=debug

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8600
VITE_API_URL=http://localhost:8600
REACT_APP_API_URL=http://localhost:8600

# CORS Configuration
CORS_ORIGINS=http://localhost:3050,http://localhost:3051,http://localhost:3030,http://localhost:3040,http://localhost:3060

# Twilio (WhatsApp Integration) - Optional for development
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# MercadoPago Integration - Optional for development
MERCADOPAGO_API_KEY=your-mercadopago-api-key
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token

# Email Configuration - Optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@wapsell.com

# AWS Configuration - Optional
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=wapsell-uploads

# Application Branding
APP_NAME=Wapsell
APP_COMPANY=Otra Ronda Mas
APP_VERSION=1.0.0

# Logging & Monitoring - Optional
SENTRY_DSN=https://your-sentry-dsn

# Feature Flags
FEATURE_MULTI_TENANT=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_PAYMENT_INTEGRATION=true
FEATURE_INVENTORY_MANAGEMENT=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
